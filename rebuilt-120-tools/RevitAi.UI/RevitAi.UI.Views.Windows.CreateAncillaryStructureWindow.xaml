<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.CreateAncillaryStructureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitAi.UI.Views.Windows" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="创建道路附属结构" Height="850" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:AncillaryStructureTypeConverter x:Key="StructureTypeConverter" />
      <converters:AncillaryPositionTypeConverter x:Key="PositionTypeConverter" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SectionHeaderBrush" Color="#FF0277BD" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style x:Key="SectionBorder" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="Border.Padding" Value="12" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="创建道路附属结构" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
    <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="选择路线:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" DisplayMemberPath="Name" Padding="6" FontSize="13" ItemsSource="{Binding RoadProjects}" SelectedItem="{Binding SelectedRoadProject}" />
        <Button Grid.Column="2" Content="刷新" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding LoadRoadProjectsCommand}" />
        <Button Grid.Column="3" Content="管理路线" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding NavigateToRoadProjectManagementCommand}" />
      </Grid>
    </Border>
    <TabControl Grid.Row="2" BorderThickness="0" Padding="0" SelectionChanged="MainTabControl_SelectionChanged">
      <TabItem Header="附属结构定义">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,6,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="附属结构列表" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                  <Button Content="添加结构" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding AddAncillaryStructureCommand}" />
                  <Button Content="删除选中" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding RemoveSelectedAncillaryStructureCommand}" />
                  <Button Content="上移" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding MoveAncillaryStructureUpCommand}" />
                  <Button Content="下移" Style="{StaticResource SmallButton}" Command="{Binding MoveAncillaryStructureDownCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding AncillaryStructures}" SelectedItem="{Binding SelectedAncillaryStructure}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="2">
                        <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Margin="0,0,8,0">
                          <Shape.Fill>
                            <SolidColorBrush Color="{Binding Color}" />
                          </Shape.Fill>
                        </Rectangle>
                        <TextBlock FontWeight="Medium" Margin="0,0,8,0" Text="{Binding Name}" />
                        <TextBlock Foreground="#99666666" Margin="0,0,8,0" Text="{Binding StructureType, Converter={StaticResource StructureTypeConverter}}" />
                        <TextBlock Foreground="#99666666" Margin="0,0,8,0" Text="{Binding PositionType, Converter={StaticResource PositionTypeConverter}}" />
                        <TextBlock Foreground="#99666666">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="宽:{0}mm 偏移:{1}mm">
                              <Binding Path="Width" />
                              <Binding Path="HorizontalOffset" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="6,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="结构参数编辑" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,12" />
                  <Grid DataContext="{Binding SelectedAncillaryStructure}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="结构名称:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Padding="4" Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="结构类型:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" SelectedIndex="{Binding StructureTypeIndex, UpdateSourceTrigger=PropertyChanged}">
                      <ComboBoxItem Content="梯形" />
                      <ComboBoxItem Content="矩形" />
                      <ComboBoxItem Content="矩形空心" Visibility="Collapsed" />
                      <ComboBoxItem Content="单坡面层" Visibility="Collapsed" />
                      <ComboBoxItem Content="双坡面层" Visibility="Collapsed" />
                      <ComboBoxItem Content="圆角路沿石" Visibility="Collapsed" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="位置类型:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" SelectedIndex="{Binding PositionTypeIndex, UpdateSourceTrigger=PropertyChanged}">
                      <ComboBoxItem Content="左侧" />
                      <ComboBoxItem Content="右侧" />
                      <ComboBoxItem Content="两侧对称" />
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="水平偏移:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="3" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding HorizontalOffset, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,8" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="高程差:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="4" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding ElevationDifference, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,8" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="宽度:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="5" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,8" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="高度:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="6" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,8" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="边坡坡度:" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="7" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding SlopeRatio, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="1:n" VerticalAlignment="Center" Margin="4,0,0,8" />
                    <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" FontSize="10" Foreground="#99999966" Margin="0,4,0,0" TextWrapping="Wrap">
                      <Run Text="水平偏移：相对于路面首层外边缘，正值向外（远离路面），负值向内" />
                      <LineBreak />
                      <Run Text="高程差：正值高于主路，负值低于主路" />
                      <LineBreak />
                      <Run Text="边坡坡度：仅梯形结构有效，1:n 表示垂直方向 n 毫米对应水平方向 1 毫米" />
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="附属结构断面预览" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Text="滚轮缩放 · 左键/中键拖动 · 双击适应窗口" FontSize="11" Foreground="#99666666" Margin="0,0,0,8" />
              <Canvas Name="AncillaryPreviewCanvas" Background="#FFFAFAFA" ClipToBounds="True" MouseWheel="AncillaryPreviewCanvas_MouseWheel" MouseLeftButtonDown="AncillaryPreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="AncillaryPreviewCanvas_MouseLeftButtonUp" PreviewMouseDown="AncillaryPreviewCanvas_PreviewMouseDown" PreviewMouseUp="AncillaryPreviewCanvas_PreviewMouseUp" MouseMove="AncillaryPreviewCanvas_MouseMove" SizeChanged="AncillaryPreviewCanvas_SizeChanged">
                <Canvas Name="AncillaryPreviewContent" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                  <UIElement.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="AncillaryPreviewScale" ScaleX="1" ScaleY="1" />
                      <TranslateTransform x:Name="AncillaryPreviewTranslate" X="0" Y="0" />
                    </TransformGroup>
                  </UIElement.RenderTransform>
                  <ItemsControl ItemsSource="{Binding AncillaryStructurePreviewData}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Polygon Stroke="#FF555555" Points="{Binding Points}" StrokeThickness="{Binding StrokeThickness}">
                          <Shape.Fill>
                            <SolidColorBrush Opacity="0.7" Color="{Binding FillColor}" />
                          </Shape.Fill>
                        </Polygon>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Canvas>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="平面布置">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionBorder}" Margin="0,0,0,6">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="附属结构列表（选中查看布置段明细）" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,8" />
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#FFF9F9F9" Height="150" ItemsSource="{Binding AncillaryStructures}" SelectedItem="{Binding SelectedStructureForLayout}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="颜色" Width="40" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Ellipse Width="16" Height="16" Stroke="#DDDDDD" StrokeThickness="1" Margin="0,0,0,0" Fill="{Binding Color}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="结构名称" Width="100" IsReadOnly="True" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="结构类型" Width="80" IsReadOnly="True" Binding="{Binding StructureTypeDisplay}" />
                    <DataGridTextColumn Header="位置" Width="60" IsReadOnly="True" Binding="{Binding PositionTypeDisplay}" />
                    <DataGridTextColumn Header="布置段数" Width="60" IsReadOnly="True" Binding="{Binding LayoutSegmentsCountText}" />
                    <DataGridTextColumn Header="总布置长度(m)" Width="80" IsReadOnly="True" Binding="{Binding TotalLayoutLength, StringFormat={}{0:F1}}" />
                    <DataGridTextColumn Header="总预计数量" Width="70" IsReadOnly="True" Binding="{Binding TotalEstimatedCount, StringFormat={}{0} 个}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="布置段明细" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,8" />
                <Border DockPanel.Dock="Bottom" Background="#FFF0F7FF" BorderBrush="#FFD0E4FF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                  <Grid DataContext="{Binding TempLayoutSegment}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="起始桩号:" VerticalAlignment="Center" Margin="0,0,0,4" />
                    <Grid Row="0" Column="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding StartStationKmInteger, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="1" Text="km" VerticalAlignment="Center" Margin="0,0,8,4" />
                      <TextBlock Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,8,4" />
                      <TextBox Grid.Column="3" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding StartStationMeter, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="终止桩号:" VerticalAlignment="Center" Margin="0,0,0,4" />
                    <Grid Row="1" Column="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding EndStationKmInteger, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="1" Text="km" VerticalAlignment="Center" Margin="0,0,8,4" />
                      <TextBlock Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,8,4" />
                      <TextBox Grid.Column="3" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding EndStationMeter, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </Grid>
                    <Grid Row="2" Column="0" ColumnSpan="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="模型长度:" VerticalAlignment="Center" Margin="0,0,0,4" />
                      <TextBox Grid.Column="1" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding ModelLength, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#999999" />
                      <TextBlock Grid.Column="3" Text="布置长度:" VerticalAlignment="Center" Margin="0,0,4,4" FontWeight="Bold" />
                      <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#FF0277BD" Text="{Binding LayoutLength, StringFormat={}{0:F1}m}" />
                      <TextBlock Grid.Column="5" Text="" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="预计数量:" VerticalAlignment="Center" Margin="0,0,4,4" FontWeight="Bold" />
                      <TextBlock Grid.Column="7" VerticalAlignment="Center" Foreground="#FF0277BD" Text="{Binding EstimatedModelCount, StringFormat={}{0} 个}" />
                    </Grid>
                  </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="添加布置段" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding AddLayoutSegmentCommand}" />
                  <Button Content="删除选中" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding RemoveSelectedLayoutSegmentCommand}" />
                  <Button Content="应用修改 ✓" Background="#FF4CAF50" Foreground="#FFFFFFFF" FontWeight="Bold" Padding="12,6" Margin="0,0,12,0" BorderThickness="0" Command="{Binding ApplyLayoutSegmentCommand}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF45A049" />
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#FF3E8E41" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                </StackPanel>
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#FFF9F9F9" ItemsSource="{Binding SelectedStructureForLayout.LayoutSegments, Mode=OneWay}" SelectedItem="{Binding SelectedLayoutSegment}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="起始桩号" Width="90" IsReadOnly="True" Binding="{Binding StartStationDisplay}" />
                    <DataGridTextColumn Header="终止桩号" Width="90" IsReadOnly="True" Binding="{Binding EndStationDisplay}" />
                    <DataGridTextColumn Header="模型长度(m)" Width="100" Binding="{Binding ModelLength}" />
                    <DataGridTextColumn Header="布置长度(m)" Width="100" IsReadOnly="True" Binding="{Binding LayoutLength, StringFormat={}{0:F1}}" />
                    <DataGridTextColumn Header="预计数量" Width="80" IsReadOnly="True" Binding="{Binding EstimatedModelCount}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </DockPanel>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="6,0,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="平面曲线预览" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Text="滚轮缩放 · 左键/中键拖动 · 右键拖动旋转 · 双击适应窗口" FontSize="11" Foreground="#99666666" Margin="0,0,0,8" />
              <Canvas Name="PlanPreviewCanvas" Background="#FFFAFAFA" ClipToBounds="True" MouseWheel="PlanPreviewCanvas_MouseWheel" MouseLeftButtonDown="PlanPreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PlanPreviewCanvas_MouseLeftButtonUp" MouseRightButtonDown="PlanPreviewCanvas_MouseRightButtonDown" MouseRightButtonUp="PlanPreviewCanvas_MouseRightButtonUp" PreviewMouseDown="PlanPreviewCanvas_PreviewMouseDown" PreviewMouseUp="PlanPreviewCanvas_PreviewMouseUp" MouseMove="PlanPreviewCanvas_MouseMove" SizeChanged="PlanPreviewCanvas_SizeChanged">
                <Canvas Name="PlanPreviewContent" Width="{Binding PlanPreviewWidth}" Height="{Binding PlanPreviewHeight}">
                  <UIElement.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PlanPreviewScale" ScaleX="1" ScaleY="1" />
                      <RotateTransform x:Name="PlanPreviewRotate" Angle="0" CenterX="0" CenterY="0" />
                      <TranslateTransform x:Name="PlanPreviewTranslate" X="0" Y="0" />
                    </TransformGroup>
                  </UIElement.RenderTransform>
                  <Polyline Stroke="#FF0277BD" Points="{Binding PlanLayoutPreviewData.CenterlinePoints}" StrokeThickness="{Binding PlanLayoutPreviewData.StrokeThickness}" Fill="{x:Null}" />
                  <Polyline Stroke="#80CCCCCC" Points="{Binding PlanLayoutPreviewData.LeftBoundaryPoints}" StrokeThickness="{Binding PlanLayoutPreviewData.BoundaryStrokeThickness}" Fill="{x:Null}" />
                  <Polyline Stroke="#80CCCCCC" Points="{Binding PlanLayoutPreviewData.RightBoundaryPoints}" StrokeThickness="{Binding PlanLayoutPreviewData.BoundaryStrokeThickness}" Fill="{x:Null}" />
                  <ItemsControl ItemsSource="{Binding PlanLayoutPreviewData.CrossSectionLines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Line Stroke="#40CCCCCC" X1="{Binding LeftPoint.X}" Y1="{Binding LeftPoint.Y}" X2="{Binding RightPoint.X}" Y2="{Binding RightPoint.Y}" StrokeThickness="{Binding StrokeThickness}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding PlanLayoutPreviewData.AncillaryStructureLayoutLines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Line X1="{Binding StartPoint.X}" Y1="{Binding StartPoint.Y}" X2="{Binding EndPoint.X}" Y2="{Binding EndPoint.Y}" Stroke="{Binding Color}" StrokeThickness="{Binding DataContext.PlanLayoutPreviewData.BoundaryStrokeThickness, ElementName=PlanPreviewCanvas}" StrokeDashArray="{Binding StrokeDashArray}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding PlanLayoutPreviewData.StationMarkers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Canvas Width="50" Height="50">
                          <Ellipse Canvas.Left="-1" Canvas.Top="-1" Stroke="#00CCCCCC" StrokeThickness="0" Fill="#00FFFFFF" RenderTransformOrigin="0.5,0.5" Width="{Binding DataContext.PlanLayoutPreviewData.MarkerSize, ElementName=PlanPreviewCanvas}" Height="{Binding DataContext.PlanLayoutPreviewData.MarkerSize, ElementName=PlanPreviewCanvas}">
                            <UIElement.RenderTransform>
                              <RotateTransform Angle="{Binding InverseRotationAngle, ElementName=PlanPreviewCanvas}" />
                            </UIElement.RenderTransform>
                          </Ellipse>
                          <TextBlock Foreground="#DD000000" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0.5,0" Text="{Binding DisplayText}" FontSize="{Binding DataContext.PlanLayoutPreviewData.FontSize, ElementName=PlanPreviewCanvas}">
                            <UIElement.RenderTransform>
                              <RotateTransform Angle="{Binding InverseRotationAngle, ElementName=PlanPreviewCanvas}" />
                            </UIElement.RenderTransform>
                          </TextBlock>
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Canvas>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="保存到路线" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0" Command="{Binding SaveDataToRoadCommand}" />
          <Button Content="创建附属结构" Style="{StaticResource PrimaryButton}" Padding="20,8" Command="{Binding CreateAncillaryStructureCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="4" Background="{StaticResource PrimaryLightBrush}" Padding="12,6" CornerRadius="4" Margin="0,8,0,0">
      <TextBlock FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}" Text="{Binding StatusMessage}" />
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar Width="200" Height="20" IsIndeterminate="True" Foreground="#FFFFFFFF" Margin="0,0,0,12" />
        <TextBlock Text="正在创建附属结构..." FontSize="14" Foreground="#FFFFFFFF" />
      </StackPanel>
    </Border>
  </Grid>
</Window>