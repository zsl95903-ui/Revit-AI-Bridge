<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.TopographyFromFloorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="按楼板创建地形" Height="520" Width="350" WindowStartupLocation="Manual" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#FFBDBDBD" />
            <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="#FFBDBDBD" />
            <Setter Property="BorderBrush" Value="#FFE0E0E0" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="按楼板创建地形" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
    <TextBlock Grid.Row="0" Text="根据楼板轮廓从地形中裁剪出新地形" FontSize="13" Foreground="#FF666666" Margin="0,28,0,16" />
    <Border Grid.Row="0" Background="#FFF4CCCC" BorderBrush="#FFCC0000" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0" Visibility="{Binding IsVersionUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚠️" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
        <TextBlock Text="暂不支持 Revit 2025 及以上版本" FontSize="13" FontWeight="SemiBold" Foreground="#FFCC0000" VerticalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="（地形 API 已变更，需要使用 Toposolid.Split）" FontSize="12" Foreground="#FFCC0000" VerticalAlignment="Center" Margin="4,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1">
      <TextBlock Text="1. 选择楼板" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Button Content="选择楼板" Style="{StaticResource SecondaryButton}" Width="200" Height="36" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding SelectFloorsCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      <TextBlock FontSize="13" Margin="0,0,0,16" Text="{Binding SelectedFloorCount, StringFormat=已选择 {0} 个楼板}" />
      <TextBlock Text="2. 选择地形（单选）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Button Content="选择地形" Style="{StaticResource SecondaryButton}" Width="200" Height="36" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding SelectTopographyCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      <TextBlock FontSize="13" Margin="0,0,0,16" Text="{Binding SelectedTopographyName, StringFormat=已选择: {0}}" />
      <Border Background="#FFF5F5F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding StatusMessage}" />
          <StackPanel Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="0,0,0,8">
              <TextBlock FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ProgressText}" />
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}/{1}">
                    <Binding Path="CurrentProgress" />
                    <Binding Path="TotalProgress" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
            <ProgressBar Height="8" Minimum="0" Background="#FFE0E0E0" Foreground="{StaticResource PrimaryBrush}" Maximum="{Binding TotalProgress}" Value="{Binding CurrentProgress}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="100" Height="40" Margin="0,0,12,0" Command="{Binding CloseCommand}" Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      <Button Content="创建地形" Style="{StaticResource PrimaryButton}" Width="120" Height="40" FontWeight="SemiBold" Command="{Binding CreateTopographyCommand}" IsEnabled="{Binding CanCreate}" />
    </StackPanel>
  </Grid>
</Window>