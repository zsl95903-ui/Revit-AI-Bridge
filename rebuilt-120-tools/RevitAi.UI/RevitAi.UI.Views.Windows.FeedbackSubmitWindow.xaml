<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.FeedbackSubmitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="问题反馈" Width="500" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FF2196F3" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4" Cursor="Hand">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FF1976D2" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="问题反馈" FontSize="20" FontWeight="Bold" Foreground="#FF2196F3" Margin="0,0,0,20" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="反馈标题 *" FontSize="12" FontWeight="Medium" Foreground="#FF666666" Margin="0,0,0,5" />
        <TextBox Height="36" Padding="10,0" FontSize="13" BorderBrush="#DDDDDD" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,20" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="问题描述 *" FontSize="12" FontWeight="Medium" Foreground="#FF666666" Margin="0,0,0,5" />
        <TextBox Height="150" Padding="10" FontSize="13" BorderBrush="#DDDDDD" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="联系邮箱（可选，方便我们回复您）" FontSize="12" FontWeight="Medium" Foreground="#FF666666" Margin="0,0,0,5" />
        <TextBox Height="36" Padding="10,0" FontSize="13" BorderBrush="#DDDDDD" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,20" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="附件（可选）" FontSize="12" FontWeight="Medium" Foreground="#FF666666" Margin="0,0,0,5" />
        <Border BorderBrush="#DDDDDD" BorderThickness="1" Background="#F9F9F9" Height="100" CornerRadius="4" Cursor="Hand" AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave" MouseLeftButtonUp="OnBorderClick">
          <Grid>
            <TextBlock Text="点击选择文件或拖拽文件到此处" FontSize="12" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl Margin="8" ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#E3F2FD" Padding="8,4" Margin="0,0,8,8" CornerRadius="4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                        <TextBlock FontSize="11" Foreground="#FF666666" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding FileSizeText}" />
                        <Button Content="×" Width="20" Height="20" Padding="0" Margin="0" Background="#FF5252" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="12" Cursor="Hand" VerticalAlignment="Center" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="取消" Width="80" Height="36" FontSize="13" Margin="0,0,10,0" Background="#F5F5F5" Foreground="#FF666666" BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand" Command="{Binding CancelCommand}" />
      <Button Content="提交反馈" Width="100" Height="36" FontSize="13" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" />
    </StackPanel>
  </Grid>
</Window>