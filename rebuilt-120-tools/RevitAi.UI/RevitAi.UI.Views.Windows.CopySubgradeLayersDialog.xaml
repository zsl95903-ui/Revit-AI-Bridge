<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.CopySubgradeLayersDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择目标路线" Height="400" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow" Topmost="True" Background="#FFFFFF" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SectionHeaderBrush" Color="#FF0277BD" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="选择要复制的目标路线" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,12" />
    <TextBlock Grid.Row="1" Text="将当前路基层定义复制到选中的路线（覆盖原有配置）" FontSize="12" Foreground="#99666666" Margin="0,0,0,8" />
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
      <ListBox Name="RoadListBox" BorderThickness="0" Background="#00FFFFFF" SelectionMode="Single">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox FontSize="13" Margin="6,3" VerticalAlignment="Center" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="全选" Style="{StaticResource SmallButton}" Background="#FFF5F5F5" Foreground="{StaticResource TextBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Width="70" Click="SelectAll_Click" />
        <Button Content="取消全选" Style="{StaticResource SmallButton}" Background="#FFF5F5F5" Foreground="{StaticResource TextBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Width="70" Margin="6,0,0,0" Click="DeselectAll_Click" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Click="Cancel_Click" />
        <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="80" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>