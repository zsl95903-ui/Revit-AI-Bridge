<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.SnippetDetailDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="代码片段详情" Height="700" Width="800" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="24,16" Background="#FFFFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="#DD000000" TextWrapping="Wrap" />
          <TextBlock Name="DescriptionText" FontSize="13" Foreground="#88000000" TextWrapping="Wrap" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Name="CategoryBadge" FontSize="11" Foreground="#FFFFFFFF" Padding="6,3" Background="#FF9C27B0" Margin="0,0,8,0" />
            <TextBlock Name="AuthorText" FontSize="12" Foreground="#88000000" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <Border Name="PriceBadge" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,6" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="PriceText" FontSize="14" FontWeight="SemiBold" Foreground="#FF9C27B0" />
              <TextBlock Text=" ⚡" FontSize="14" Foreground="#FF9C27B0" Margin="4,0,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Name="OwnedBadge" Text="✅ 已拥有" FontSize="12" Foreground="#4CAF50" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
      <StackPanel>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="📥 下载" FontSize="12" Foreground="#88000000" />
            <TextBlock Name="DownloadCountText" FontSize="16" FontWeight="SemiBold" Foreground="#DD000000" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="👁️ 浏览" FontSize="12" Foreground="#88000000" />
            <TextBlock Name="ViewCountText" FontSize="16" FontWeight="SemiBold" Foreground="#DD000000" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="⭐ 收藏" FontSize="12" Foreground="#88000000" />
            <TextBlock Name="FavoriteCountText" FontSize="16" FontWeight="SemiBold" Foreground="#DD000000" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="📊 评分" FontSize="12" Foreground="#88000000" />
            <TextBlock Name="RatingText" FontSize="16" FontWeight="SemiBold" Foreground="#DD000000" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
        <WrapPanel Name="TagsPanel" Orientation="Horizontal" Margin="0,0,0,24" />
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Background="#FFFFFFFF" Margin="0,0,0,24">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
              <Grid>
                <TextBlock Text="代码内容" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" />
                <Button Name="CopyCodeButton" Content="复制" HorizontalAlignment="Right" Padding="8,4" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Cursor="Hand" Click="CopyCodeButton_Click" />
              </Grid>
            </Border>
            <ScrollViewer Name="CodeContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
              <Border Name="CodeContentBorder" Background="#FFFFFFFF" Padding="12">
                <TextBlock Name="CodeContentText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#DD000000" />
              </Border>
            </ScrollViewer>
            <Border Name="LockedContentBorder" Grid.Row="1" Background="#FFF8F8F8" Padding="24" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="此代码片段需要购买后才能查看" FontSize="13" Foreground="#88000000" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Name="RatingBorder" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Background="#FFFFFFFF">
          <StackPanel>
            <TextBlock Text="您的评分" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <RadioButton Name="Rating5" Content="⭐⭐⭐⭐⭐" Tag="5" GroupName="RatingGroup" FontSize="18" Margin="0,0,16,0" Checked="RatingRadioButton_Checked" />
              <RadioButton Name="Rating4" Content="⭐⭐⭐⭐" Tag="4" GroupName="RatingGroup" FontSize="18" Margin="0,0,16,0" Checked="RatingRadioButton_Checked" />
              <RadioButton Name="Rating3" Content="⭐⭐⭐" Tag="3" GroupName="RatingGroup" FontSize="18" Margin="0,0,16,0" Checked="RatingRadioButton_Checked" />
              <RadioButton Name="Rating2" Content="⭐⭐" Tag="2" GroupName="RatingGroup" FontSize="18" Margin="0,0,16,0" Checked="RatingRadioButton_Checked" />
              <RadioButton Name="Rating1" Content="⭐" Tag="1" GroupName="RatingGroup" FontSize="18" Checked="RatingRadioButton_Checked" />
            </StackPanel>
            <TextBlock Name="RatingStatusText" FontSize="12" Foreground="#88000000" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="24,16" Background="#FFFFFFFF">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Name="FavoriteButton" Width="100" Height="36" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Cursor="Hand" Click="FavoriteButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="FavoriteIconText" Text="🤍" FontSize="16" Margin="0,0,8,0" />
              <TextBlock Name="FavoriteButtonText" Text="收藏" FontSize="13" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="CloseButton" Content="关闭" Width="80" Height="36" Margin="0,0,12,0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Cursor="Hand" Click="CloseButton_Click" />
          <Button Name="DownloadButton" Content="下载" Width="100" Height="36" Background="#FF0277BD" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" Click="DownloadButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>