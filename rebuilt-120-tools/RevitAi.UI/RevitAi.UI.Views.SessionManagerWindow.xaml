<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.SessionManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewmodels="clr-namespace:RevitAi.UI.ViewModels" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="会话管理" Width="900" Height="600" WindowStartupLocation="CenterOwner" Background="#FFF9F9F9" xmlns:views="clr-namespace:RevitAi.UI.Views" Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="15,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="📚" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Text="会话管理" FontSize="18" FontWeight="Bold" Foreground="#FF333333" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Width="90" Height="32" Margin="0,0,8,0" FontSize="12" Command="{Binding RefreshCommand}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FF0078D4" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF106EBE" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel Orientation="Horizontal" Margin="12,0">
              <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text=" 刷新" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="110" Height="32" FontSize="12" Command="{Binding DeleteSelectedCommand}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FFE74C3C" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC0392B" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel Orientation="Horizontal" Margin="12,0">
              <TextBlock Text="🗑" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text=" 删除选中" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="LeftColumn" Width="2*" />
        <ColumnDefinition Name="SplitterColumn" Width="3" />
        <ColumnDefinition Name="RightColumn" Width="3*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox Name="SelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked" />
              <TextBlock Grid.Column="1" Text="会话列表" FontWeight="Bold" Foreground="#FF666666" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Foreground="#FF999999" VerticalAlignment="Center" Text="{Binding Sessions.Count, StringFormat=共 {0} 个}" />
            </Grid>
          </Border>
          <ListBox Name="SessionsListBox" Grid.Row="1" BorderThickness="0" Background="#FFFFFFFF" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="10,8" Background="#FFFFFFFF">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="Bold" Foreground="#FF333333" TextTrimming="CharacterEllipsis" MaxWidth="250" Text="{Binding Title}" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock FontSize="11" Foreground="#FF999999" Text="{Binding UpdatedAt, StringFormat=更新: {0:yyyy-MM-dd HH:mm}}" />
                        <TextBlock FontSize="11" Foreground="#FF999999" Margin="5,0,0,0" Text="{Binding RoundCount, StringFormat= | {0} 轮}" />
                      </StackPanel>
                      <TextBlock FontSize="11" Foreground="#FF666666" TextTrimming="CharacterEllipsis" MaxWidth="250" Margin="0,2,0,0" Text="{Binding Preview}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border Name="Border" Background="#FFFFFFFF" BorderThickness="2" BorderBrush="#FF0078D4" CornerRadius="4" Margin="2" Padding="4">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="ListBoxItem.IsSelected" Value="False">
                          <Setter TargetName="Border" Property="Border.BorderBrush" Value="#00FFFFFF" />
                          <Setter TargetName="Border" Property="Border.Background" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="Border" Property="Border.Background" Value="#FFF0F8FF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>
      <GridSplitter Name="MainGridSplitter" Grid.Column="1" HorizontalAlignment="Center" Width="5" Background="#FFE0E0E0" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />
      <Border Grid.Column="2" Background="#FFFFFFFF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
            <TextBlock Text="会话预览" FontWeight="Bold" Foreground="#FF666666" />
          </Border>
          <TextBox Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="#00FFFFFF" Foreground="#FF333333" FontSize="13" FontFamily="Segoe UI, Consolas, Microsoft YaHei UI" TextWrapping="Wrap" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10" Text="{Binding PreviewContent}" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="15,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="🧹 自动清理:" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Width="100" Height="28" FontSize="12" VerticalContentAlignment="Center" ItemsSource="{Binding CleanupDayOptions}" SelectedIndex="{Binding SelectedDaysIndex, Mode=TwoWay}" />
          <Button Width="100" Height="28" Margin="10,0,0,0" FontSize="12" Command="{Binding CleanupOldSessionsCommand}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FFFF9800" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF57C00" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel Orientation="Horizontal" Margin="12,0">
              <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text=" 执行清理" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="⏳" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="处理中..." VerticalAlignment="Center" Foreground="#FF999999" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>