<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.AIProviderEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" Title="AI提供商配置" Width="400" Height="640" ResizeMode="NoResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Opacity" Value="0.8" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FFBDBDBD" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FF9E9E9E" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="#FFE0E0E0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
      </Style>
      <Style x:Key="ModernPasswordBox" TargetType="{x:Type PasswordBox}">
        <Setter Property="BorderBrush" Value="#FFE0E0E0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16">
      <StackPanel>
        <TextBlock Text="提供商 *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox Name="ProviderComboBox" Height="30" FontSize="13" SelectionChanged="OnProviderChanged">
          <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
          <ComboBoxItem Content="OpenAI" Tag="openai" />
          <ComboBoxItem Content="Ollama (本地)" Tag="ollama" />
          <ComboBoxItem Content="vLLM (本地)" Tag="vllm" />
          <ComboBoxItem Content="自定义" Tag="custom" />
        </ComboBox>
        <TextBlock Text="显示名称 *" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBox Name="DisplayNameTextBox" Style="{StaticResource ModernTextBox}" Text="{Binding DisplayName}" />
        <TextBlock Text="模型名称 *" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBox Name="ModelNameTextBox" Style="{StaticResource ModernTextBox}" Text="{Binding ModelName}" />
        <TextBlock Text="API Endpoint" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBox Name="EndpointTextBox" Style="{StaticResource ModernTextBox}" Text="{Binding ProviderEndpoint}" />
        <TextBlock Name="ApiKeyLabel" Text="API Key *" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
        <PasswordBox Name="ApiKeyPasswordBox" Style="{StaticResource ModernPasswordBox}" />
        <TextBlock Text="高级选项" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="最大Token数" FontSize="12" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding MaxTokens}" />
        </Grid>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="温度 (0-1)" FontSize="12" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding Temperature}" />
        </Grid>
        <CheckBox Name="IsDefaultCheckBox" Content="设为默认提供商" FontSize="13" Margin="0,8,0,0" IsChecked="{Binding IsDefault}" />
        <CheckBox Name="SupportsVisionCheckBox" Content="支持视觉能力（图片、PDF 等多模态）" FontSize="13" Margin="0,8,0,0" ToolTipService.ShowDuration="5000" IsChecked="{Binding SupportsVision}">
          <FrameworkElement.ToolTip>
            <ToolTip Content="勾选此项表示模型支持图片、PDF 等多模态输入。如果您使用的是视觉模型（如 GPT-4V、Qwen-VL 等），请勾选此选项。" />
          </FrameworkElement.ToolTip>
        </CheckBox>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Height="32" Margin="0,0,12,0" Click="OnCancelClick" />
        <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="80" Height="32" Click="OnSaveClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>