<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.RoadModelPlacementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="模型放置" Height="650" Width="800" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:EnumToIndexConverter x:Key="EnumToIndexConverter" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="模型放置" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="选择项目" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
            <ComboBox DisplayMemberPath="Name" Padding="8" Margin="0,0,0,8" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />
            <Button Content="刷新项目列表" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding RefreshProjectsCommand}" />
          </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="放置场景" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
            <ComboBox Name="ScenarioComboBox" Padding="8" Margin="0,0,0,8" SelectedIndex="{Binding SelectedScenario, Converter={StaticResource EnumToIndexConverter}}" SelectionChanged="ScenarioComboBox_SelectionChanged">
              <ComboBoxItem Content="单个放置" />
              <ComboBoxItem Content="等间距放置" />
              <ComboBoxItem Content="自定义列表" />
            </ComboBox>
            <StackPanel Name="SinglePlacementPanel">
              <TextBlock Text="桩号位置 (公里):" Margin="0,8,0,4" />
              <TextBox Padding="8" Margin="0,0,0,4" Text="{Binding StationKm, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Name="IntervalPlacementPanel" Visibility="Collapsed">
              <TextBlock Text="起始桩号 (公里):" Margin="0,8,0,4" />
              <TextBox Padding="8" Margin="0,0,0,4" Text="{Binding StartStationKm, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="结束桩号 (公里):" Margin="0,0,0,4" />
              <TextBox Padding="8" Margin="0,0,0,4" Text="{Binding EndStationKm, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="放置间距 (米):" Margin="0,0,0,4" />
              <TextBox Padding="8" Text="{Binding PlacementInterval, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Name="CustomListPanel" Visibility="Collapsed">
              <TextBlock Text="自定义桩号列表（逗号分隔，单位:公里）:" Margin="0,8,0,4" />
              <TextBox Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding CustomStationList, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="偏移参数" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="横向偏移 (米):" Margin="0,0,0,4" />
              <TextBox Grid.Row="0" Grid.Column="1" Padding="8" Margin="0,0,0,4" Text="{Binding LateralOffset, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="纵向偏移 (米):" Margin="0,0,0,4" />
              <TextBox Grid.Row="1" Grid.Column="1" Padding="8" Margin="0,0,0,4" Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="旋转角度 (度):" Margin="0,0,0,4" />
              <TextBox Grid.Row="2" Grid.Column="1" Padding="8" Text="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="族选择" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
            <TextBlock Text="族名称:" Margin="0,0,0,4" />
            <TextBox Padding="8" Margin="0,0,0,4" Text="{Binding FamilyName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="族类型名称:" Margin="0,0,0,4" />
            <TextBox Padding="8" Text="{Binding FamilyTypeName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
          <StackPanel>
            <TextBlock Text="预览" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
            <Button Content="预览放置位置" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding PreviewPlacementCommand}" />
            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="#99000000" Text="{Binding PreviewResult}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="执行放置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding ExecutePlacementCommand}" />
      <Button Content="关闭" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" />
    </StackPanel>
    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" Padding="16,8" CornerRadius="4" Margin="0,8,0,0">
      <TextBlock FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}" Text="{Binding StatusMessage}" />
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar Width="200" Height="20" IsIndeterminate="True" Foreground="#FFFFFFFF" Margin="0,0,0,16" />
        <TextBlock Text="正在处理..." FontSize="16" Foreground="#FFFFFFFF" Margin="0,0,0,8" />
      </StackPanel>
    </Border>
  </Grid>
</Window>