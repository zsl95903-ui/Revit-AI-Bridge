<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.DefineFoundationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="定义基础部件" Height="650" Width="1000" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:converters="clr-namespace:RevitAi.UI.Converters" />
      <converters:StyleItemSelectionConverter x:Key="StyleSelectionConverter" xmlns:converters="clr-namespace:RevitAi.UI.Converters" />
      <converters:StyleItemIdEqualityConverter x:Key="StyleIdEqualityConverter" xmlns:converters="clr-namespace:RevitAi.UI.Converters" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="StyleItem" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Border.Padding" Value="8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Border.CornerRadius" Value="4" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="定义基础部件" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
    <Border Grid.Row="1" Background="{StaticResource PrimaryLightBrush}" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
      <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}">
        <Run Text="选择左侧的样式，输入部件名称，点击&quot;添加到列表&quot;按钮。可以添加多个基础部件定义。" />
      </TextBlock>
    </Border>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFFFF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="样式库" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            <Button Content="导入自定义样式" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="12,0,0,0" Command="{Binding ImportCustomStyleCommand}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AvailableStyles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Name="StyleBorder" Width="140" Height="140" Padding="8" Margin="4" CornerRadius="4" Cursor="Hand" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
                    <UIElement.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </UIElement.InputBindings>
                    <StackPanel>
                      <Border Width="120" Height="80" Background="#FFF5F5F5" CornerRadius="3" Margin="0,0,0,8">
                        <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" Text="{Binding Name}" />
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StyleIdEqualityConverter}">
                          <Binding Path="Id" />
                          <Binding Path="DataContext.SelectedStyle.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter TargetName="StyleBorder" Value="{StaticResource PrimaryBrush}" Property="Border.BorderBrush" />
                      <Setter TargetName="StyleBorder" Property="Border.BorderThickness" Value="3" />
                      <Setter TargetName="StyleBorder" Value="{StaticResource PrimaryLightBrush}" Property="Border.Background" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
      <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFFFF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="已定义的部件" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
          <Grid Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0" FontSize="13" Padding="8" Margin="0,0,8,8" Text="{Binding NewComponentName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="1" Content="添加到列表" Style="{StaticResource PrimaryButton}" Padding="12,8" FontSize="13" Margin="0,0,0,8" Command="{Binding AddComponentCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="12" Margin="0,0,0,0">
              <Run Text="已选择: " /> <Run Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Text="{Binding SelectedStyle.Name, Mode=OneWay, TargetNullValue=未选择}" /></TextBlock>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding UserComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Margin="0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Name}" />
                          <TextBlock FontSize="11" Foreground="#99000000" Margin="0,2,0,0">
                            <Run Text="样式: " /> <Run Text="{Binding SelectedStyle.Name}" /></TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="删除" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Background="#FFE53935" Foreground="#FFFFFFFF" BorderThickness="0" Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" Padding="12,8" CornerRadius="4" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13">
          <Run Text="已定义 " /> <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding UserComponents.Count, Mode=OneWay}" /> <Run Text=" 个部件" /></TextBlock>
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Command="{Binding CancelCommand}" />
        <Button Content="保存" Style="{StaticResource PrimaryButton}" Background="{StaticResource SuccessBrush}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
      <TextBlock Text="正在保存..." FontSize="16" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>