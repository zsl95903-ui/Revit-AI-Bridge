<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="RevitMainWindowStyle" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
    <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
    <Setter Property="Window.WindowState" Value="Normal" />
    <Setter Property="Window.WindowStyle" Value="SingleBorderWindow" />
    <Setter Property="Window.ResizeMode" Value="CanResizeWithGrip" />
    <Setter Property="Width" Value="1200" />
    <Setter Property="Height" Value="800" />
    <Setter Property="MinWidth" Value="800" />
    <Setter Property="MinHeight" Value="600" />
    <Setter Property="Window.WindowStartupLocation" Value="CenterScreen" />
  </Style>
  <Style x:Key="RevitDialogStyle" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
    <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
    <Setter Property="Window.WindowState" Value="Normal" />
    <Setter Property="Window.WindowStyle" Value="SingleBorderWindow" />
    <Setter Property="Window.ResizeMode" Value="NoResize" />
    <Setter Property="Window.ShowInTaskbar" Value="False" />
    <Setter Property="Window.WindowStartupLocation" Value="CenterOwner" />
    <Setter Property="Window.SizeToContent" Value="WidthAndHeight" />
  </Style>
  <Style x:Key="RevitLoginWindowStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource RevitDialogStyle}">
    <Setter Property="Width" Value="450" />
    <Setter Property="Height" Value="550" />
    <Setter Property="Window.ResizeMode" Value="NoResize" />
    <Setter Property="Window.ShowInTaskbar" Value="True" />
    <Setter Property="Window.WindowStartupLocation" Value="CenterScreen" />
  </Style>
  <Style x:Key="RevitSettingsWindowStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource RevitDialogStyle}">
    <Setter Property="Width" Value="700" />
    <Setter Property="Height" Value="500" />
    <Setter Property="Window.ResizeMode" Value="CanResize" />
    <Setter Property="Window.ShowInTaskbar" Value="True" />
    <Setter Property="Window.WindowStartupLocation" Value="CenterOwner" />
  </Style>
</ResourceDictionary>