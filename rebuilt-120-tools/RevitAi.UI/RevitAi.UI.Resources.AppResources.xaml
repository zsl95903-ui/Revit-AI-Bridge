<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:RevitAi.UI.Converters">
    <ResourceDictionary.MergedDictionaries>
        <!-- 自定义 Revit 风格样式 -->
        <ResourceDictionary Source="/Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Fonts.xaml" />
        <ResourceDictionary Source="/Resources/Styles/ButtonStyles.xaml" />
        <ResourceDictionary Source="/Resources/Styles/WindowStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 值转换器 -->
    <converters:OnlineStatusIconConverter x:Key="OnlineStatusIconConverter"/>
    <converters:OnlineStatusTextConverter x:Key="OnlineStatusTextConverter"/>

    <!-- 颜色和画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFF44336"/>
    <SolidColorBrush x:Key="TextBrush" Color="#DD000000"/>

    <!-- 支付相关颜色 -->
    <SolidColorBrush x:Key="AlipayBrush" Color="#FF1677FF"/>
    <SolidColorBrush x:Key="WechatBrush" Color="#FF07C160"/>
</ResourceDictionary>
