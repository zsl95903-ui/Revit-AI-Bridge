<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.UploadSnippetDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="上传代码片段到市场" Height="650" Width="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FFFFFF" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="📤 上传代码片段到市场" FontSize="20" FontWeight="SemiBold" Foreground="#DD000000" Margin="0,0,0,24" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Name="LocalSnippetsPanel" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFF8F8F8" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="从本地片段库选择" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" Margin="0,0,0,8" />
            <ComboBox Name="LocalSnippetsComboBox" Height="36" FontSize="13" DisplayMemberPath="Name" SelectionChanged="LocalSnippetsComboBox_SelectionChanged" />
          </StackPanel>
        </Border>
        <Border Name="PreviewBorder" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFFFF" Visibility="Collapsed" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="片段信息预览" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" />
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" FontSize="12" Foreground="#88000000" VerticalAlignment="Top" />
              <TextBlock Name="NamePreviewText" Grid.Row="0" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="#DD000000" Text="{Binding Name}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="描述：" FontSize="12" Foreground="#88000000" VerticalAlignment="Top" Margin="0,8,0,0" />
              <TextBlock Name="DescriptionPreviewText" Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="#DD000000" Margin="0,8,0,0" Text="{Binding Description}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="标签：" FontSize="12" Foreground="#88000000" VerticalAlignment="Top" Margin="0,8,0,0" />
              <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FFE8E8E8" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                      <TextBlock FontSize="11" Foreground="#DD000000" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="代码：" FontSize="12" Foreground="#88000000" VerticalAlignment="Top" Margin="0,8,0,0" />
              <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock Name="CodePreviewText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="#DD000000" Text="{Binding Code}" />
                </ScrollViewer>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFFFF" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="分类 *" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" Margin="0,0,0,8" />
            <ComboBox Name="CategoryComboBox" Height="36" FontSize="13">
              <ComboBoxItem Tag="modeling" Content="建模工具" />
              <ComboBoxItem Tag="annotation" Content="标注工具" />
              <ComboBoxItem Tag="analysis" Content="分析工具" />
              <ComboBoxItem Tag="view" Content="视图工具" />
              <ComboBoxItem Tag="documentation" Content="文档工具" />
              <ComboBoxItem Tag="utility" Content="实用工具" />
              <ComboBoxItem Tag="other" Content="其他" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFFFF" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="价格设置" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" Margin="0,0,0,8" />
            <RadioButton Name="FreeRadioButton" Content="免费" IsChecked="True" GroupName="PriceGroup" Margin="0,0,0,8" FontSize="13" Foreground="#DD000000" />
            <RadioButton Name="PaidRadioButton" Content="付费" IsChecked="False" GroupName="PriceGroup" FontSize="13" Foreground="#DD000000" />
            <StackPanel Orientation="Horizontal" Margin="24,8,0,0" Visibility="{Binding IsChecked, ElementName=PaidRadioButton, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="价格（电量）：" FontSize="12" Foreground="#88000000" VerticalAlignment="Center" />
              <TextBox Name="PriceTextBox" Width="80" Height="28" Margin="8,0,0,0" FontSize="13" Text="0.1" TextAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Text=" ⚡" FontSize="12" Foreground="#FF9C27B0" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="提示：付费片段将在交易后扣除购买者的电量，并增加到您的账户。" FontSize="11" Foreground="#88000000" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFF8F8F8">
          <StackPanel>
            <TextBlock Text="💡 提示" FontSize="13" FontWeight="SemiBold" Foreground="#88000000" Margin="0,0,0,8" />
            <TextBlock Text="• 上传后您可以随时编辑或下架片段" FontSize="12" Foreground="#88000000" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="• 收到的电量可用于 AI 对话或其他功能" FontSize="12" Foreground="#88000000" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="• 请确保代码不包含敏感信息或私有逻辑" FontSize="12" Foreground="#88000000" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Name="CancelButton" Content="取消" Width="80" Height="32" Margin="0,0,12,0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Cursor="Hand" Click="CancelButton_Click" />
      <Button Name="UploadButton" Content="上传" Width="80" Height="32" Background="#FF9C27B0" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" Click="UploadButton_Click" />
    </StackPanel>
  </Grid>
</Window>