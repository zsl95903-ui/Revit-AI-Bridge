<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.SignUpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="注册新账户" Width="450" Height="600" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#FFFFFFFF" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FF2196F3" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FF1976D2" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#FFBDBDBD" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="#FF2196F3" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#FF2196F3" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFE3F2FD" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="#FFBDBDBD" />
            <Setter Property="BorderBrush" Value="#FFE0E0E0" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Padding="40" CornerRadius="8">
      <UIElement.Effect>
        <DropShadowEffect Color="#FF000000" BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
      </UIElement.Effect>
      <StackPanel>
        <TextBlock Text="创建新账户" FontSize="28" FontWeight="Bold" Foreground="#FF2196F3" Margin="0,0,0,24" />
        <TextBlock Text="邮箱地址" FontSize="14" Margin="0,0,0,8" Foreground="#FF333333" />
        <TextBox Name="EmailTextBox" Margin="0,0,0,16" FontSize="14" Padding="10" BorderBrush="#FFCCCCCC" TextWrapping="NoWrap" />
        <TextBlock Text="密码" FontSize="14" Margin="0,0,0,8" Foreground="#FF333333" />
        <PasswordBox Name="PasswordBox" Margin="0,0,0,16" FontSize="14" Padding="10" BorderBrush="#FFCCCCCC" />
        <TextBlock Text="确认密码" FontSize="14" Margin="0,0,0,8" Foreground="#FF333333" />
        <PasswordBox Name="ConfirmPasswordBox" Margin="0,0,0,16" FontSize="14" Padding="10" BorderBrush="#FFCCCCCC" />
        <Border Background="#FFF3F3F3" Padding="12" CornerRadius="4" Margin="0,0,0,24">
          <StackPanel>
            <TextBlock Text="密码要求：" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#FF333333" />
            <TextBlock Text="• 至少 6 个字符" FontSize="11" Margin="0,0,0,4" Foreground="#FF666666" />
            <TextBlock Text="• 建议使用字母、数字组合以提高安全性" FontSize="11" Foreground="#FF666666" />
          </StackPanel>
        </Border>
        <TextBlock Margin="0,0,0,16" HorizontalAlignment="Right">
          <Hyperlink Foreground="#FF2196F3" TextDecorations="None" RequestNavigate="OnForgotPasswordClick">
            <Run Text="忘记密码？" />
          </Hyperlink>
        </TextBlock>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="注册" Style="{StaticResource PrimaryButtonStyle}" Height="40" FontSize="15" FontWeight="SemiBold" Command="{Binding SignUpCommand}" />
          <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Height="40" FontSize="14" Command="{Binding CancelCommand}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>