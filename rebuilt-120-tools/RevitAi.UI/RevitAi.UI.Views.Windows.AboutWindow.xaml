<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" WindowStartupLocation="CenterScreen" Title="RevitAi - 关于" Width="450" Height="800" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF1976D2" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="SecondaryBrush" Color="#FFFF9800" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFF44336" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CardBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Border.Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
      </Style>
      <Style x:Key="ModernPasswordBox" TargetType="{x:Type PasswordBox}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
      </Style>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <converters:CurrentDeviceButtonTextConverter x:Key="CurrentDeviceButtonTextConverter" />
      <converters:CurrentDeviceButtonBackgroundConverter x:Key="CurrentDeviceButtonBackgroundConverter" />
      <converters:BoolToCreditsConverter x:Key="BoolToCreditsConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PrimaryLightBrush}" Padding="40,28">
      <UIElement.Effect>
        <DropShadowEffect Color="#FF2196F3" BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
      </UIElement.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="64" Height="64" Margin="0,0,24,0">
          <Image Name="AppIconImage" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="RevitAi" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
          <TextBlock FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Text="{Binding ProductVersion}" />
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" BorderThickness="1" Padding="0">
      <TabItem Header="授权管理">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel>
            <Border Background="{StaticResource PrimaryLightBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,16">
              <UIElement.Effect>
                <DropShadowEffect Color="#FF2196F3" BlurRadius="8" ShadowDepth="1" Opacity="0.1" />
              </UIElement.Effect>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ" FontSize="28" Width="36" Height="36" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" />
                <StackPanel Grid.Column="1">
                  <Grid>
                    <TextBlock Text="授权状态" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" />
                    <Button Content="刷新" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Width="50" Height="22" FontSize="11" Padding="6,2" HorizontalAlignment="Right" Cursor="Hand" Command="{Binding RefreshAuthorizationCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="3" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </Grid>
                  <TextBlock FontSize="18" FontWeight="Bold" Margin="0,2,0,0" Text="{Binding LicenseStatus}" Foreground="{Binding StatusBrush}" />
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                      <Run Text="设备ID: " /> <Run FontWeight="SemiBold" Text="{Binding DeviceId}" /></TextBlock>
                    <Button Grid.Column="1" Content="复制" Style="{StaticResource PrimaryButton}" Width="50" Height="24" FontSize="11" Padding="8,2" Margin="4,0,0,0" Command="{Binding CopyDeviceIdCommand}" />
                  </Grid>
                  <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowLicenseDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="12">
                      <Run Text="有效期至: " /> <Run FontWeight="SemiBold" Text="{Binding LicenseExpiry}" /></TextBlock>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="13" Margin="0,0,0,4">
                    <Run Text="当前用户: " /> <Run FontWeight="Medium" Text="{Binding UserEmail}" /></TextBlock>
                  <TextBlock FontSize="12" Foreground="#FF666666">
                    <Run Text="已绑定设备: " /> <Run FontWeight="Medium" Text="{Binding DeviceCount}" /> <Run Text=" / " /> <Run FontWeight="Medium" Text="{Binding MaxDevices}" /></TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="退出登录" Style="{StaticResource PrimaryButton}" Width="100" Height="32" FontSize="13" Command="{Binding LogoutCommand}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,16,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="我的设备" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                  <Button Content="刷新" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Width="60" Height="28" FontSize="12" Padding="8,4" HorizontalAlignment="Right" Command="{Binding RefreshDevicesCommand}" />
                </Grid>
                <Border Background="#FFF3E0" Padding="12" CornerRadius="4" Margin="0,0,0,12" Visibility="{Binding ShowCurrentDeviceUnboundWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="#E65100" Margin="0,0,0,4">⚠️ 当前设备未绑定</TextBlock>
                    <TextBlock FontSize="12" Foreground="#BF360C" TextWrapping="Wrap">
                      <Run Text="您的设备尚未绑定。如果已达到设备数量上限（" /> <Run FontWeight="Medium" Text="{Binding MaxDevices}" /> <Run Text="台），请先解绑一台旧设备，然后点击&quot;刷新设备列表&quot;按钮。" /></TextBlock>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding UserDevices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8" Background="#00FFFFFF">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Medium" Margin="0,0,0,4">
                              <Run Text="{Binding DeviceName}" /> <Run Text=" (" Foreground="#FF999999" FontSize="12" /> <Run Foreground="#FF999999" FontSize="12" Text="{Binding OsInfo}" /> <Run Text=")" Foreground="#FF999999" FontSize="12" /></TextBlock>
                            <TextBlock FontSize="11" Foreground="#FF999999" Margin="0,0,0,2">
                              <Run Text="设备ID: " /> <Run Text="{Binding DeviceId}" /></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#4CAF50" Padding="8,4" CornerRadius="4" Width="60" Height="28" Visibility="{Binding IsCurrentDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <TextBlock Text="当前" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" />
                            </Border>
                            <Button Content="解绑" Background="#FF5252" Foreground="#FFFFFFFF" BorderBrush="#FF5252" Width="60" Height="28" FontSize="12" Padding="8,4" Margin="8,0,0,0" Command="{Binding DataContext.UnbindDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding DeviceId}" Visibility="{Binding IsCurrentDevice, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无绑定设备" HorizontalAlignment="Center" FontSize="13" Foreground="#FF999999" Margin="0,16,0,0" Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock FontSize="11" Foreground="#FF999999" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Run Text="已绑定 " /> <Run FontWeight="Medium" Text="{Binding DeviceCount}" /> <Run Text=" / " /> <Run FontWeight="Medium" Text="{Binding MaxDevices}" /> <Run Text=" 个设备" /></TextBlock>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16" Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="用户登录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="邮箱地址" FontSize="12" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="密码" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12" />
                <TextBlock Foreground="#E53935" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding AuthErrorMessage}" Visibility="{Binding AuthErrorMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}" />
                <Button Content="登录" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="32" Command="{Binding LoginCommand}" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="还没有账户？" FontSize="12" HorizontalAlignment="Left">
                    <Hyperlink Command="{Binding SignUpCommand}">注册新账户</Hyperlink>
                  </TextBlock>
                  <TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right">
                    <Hyperlink Command="{Binding ForgotPasswordCommand}">忘记密码？</Hyperlink>
                  </TextBlock>
                </Grid>
              </StackPanel>
            </Border>
            <Button Content="💎 购买授权" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Height="36" FontSize="14" FontWeight="SemiBold" Padding="32,8" Margin="0,8,0,0" Command="{Binding ShowPurchaseLicenseCommand}" />
            <Grid HorizontalAlignment="Center" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="📁 日志文件夹" Height="32" FontSize="12" Padding="20,6" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Margin="0,0,8,0" Command="{Binding OpenLogFolderCommand}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="4" Cursor="Hand">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <Grid Column="1" Margin="0,0,8,0">
                <Button Content="💬 问题反馈" Height="32" FontSize="12" Padding="20,6" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Command="{Binding ShowFeedbackCommand}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="4" Cursor="Hand">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="{Binding HasUnreadFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding UnreadCount}" />
                </Border>
              </Grid>
              <Button Grid.Column="2" Content="📝 更新日志" Height="32" FontSize="12" Padding="20,6" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Command="{Binding OpenChangelogCommand}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="4" Cursor="Hand">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="AI 设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="电量信息" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                  <Button Content="刷新" Background="#F5F5F5" Foreground="#666666" BorderBrush="#DDDDDD" Width="60" Height="28" FontSize="12" Padding="8,4" HorizontalAlignment="Right" Cursor="Hand" Command="{Binding RefreshAuthorizationCommand}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                </Grid>
                <Border Background="#FFF8F9FA" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="当前余额" FontSize="12" Foreground="#FF666666" />
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{Binding CreditsStatusBrush}" Text="{Binding CurrentBalance, StringFormat={}{0:F2}}" />
                        <TextBlock Text=" 电量" FontSize="14" FontWeight="Normal" VerticalAlignment="Top" Margin="2,4,0,0" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CreditsStatusText}" Foreground="{Binding CreditsStatusBrush}" />
                  </Grid>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="累计购买" FontSize="11" Foreground="#FF999999" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" Text="{Binding TotalPurchasedDisplayText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="累计消耗" FontSize="11" Foreground="#FF999999" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" Text="{Binding TotalConsumedDisplayText}" />
                  </StackPanel>
                </Grid>
                <Border Background="#FFECF0F1" CornerRadius="4" Padding="8" Margin="0,10,0,12">
                  <TextBlock FontSize="11" Foreground="#FF666666" TextWrapping="Wrap">
                    <Run Text="ℹ️ " /> <Run Text="电量通过 AI 对话消耗。不同 AI 模型的消耗速率不同，详见使用说明。" /></TextBlock>
                </Border>
                <Button Content="⚡ 购买电量" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="36" FontSize="14" FontWeight="SemiBold" Padding="32,8" Command="{Binding PurchaseCreditsCommand}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="AI 模型配置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" />
                  <Button Content="+添加提供商" Style="{StaticResource PrimaryButton}" Width="100" Height="30" FontSize="12" HorizontalAlignment="Right" Command="{Binding AddAIProviderCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding AiProviders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FFF5F5F5" Padding="12" CornerRadius="6" Margin="0,0,0,8" BorderBrush="#FF4CAF50" BorderThickness="2,0,0,0">
                        <StackPanel>
                          <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                          <TextBlock FontSize="11" Foreground="#FF666666" Text="{Binding ModelName}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无AI配置，点击上方按钮添加" FontSize="12" Foreground="#FF999999" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding HasNoAIConfigs, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="{StaticResource PrimaryLightBrush}" Padding="16,10">
      <TextBlock FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" Text="{Binding ProductCopyright}" />
    </Border>
  </Grid>
</Window>