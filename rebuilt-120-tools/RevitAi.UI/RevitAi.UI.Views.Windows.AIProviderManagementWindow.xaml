<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.AIProviderManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitAi.UI.Views.Windows" xmlns:converters="clr-namespace:RevitAi.UI.Converters" WindowStartupLocation="CenterOwner" Title="AI 提供商管理" Width="650" Height="500" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:ButtonWidthToVisibilityConverter x:Key="ButtonWidthToVisibilityConverter" Threshold="80" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Opacity" Value="0.8" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FFBDBDBD" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FF9E9E9E" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FF666666" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF0F0F0" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PrimaryLightBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="AI 提供商管理" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
        <Button Grid.Column="1" Content="➕ 添加配置" Width="140" Padding="10,6" HorizontalContentAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnAddClick" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
      <ItemsControl Name="ConfigsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0" Fill="{Binding SourceColor}" />
                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FF333333" Text="{Binding DisplayName}" />
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="#FF666666" FontSize="12" Margin="0,0,12,0" Text="{Binding ProviderDisplayName}" />
                    <TextBlock Grid.Column="1" Text="|" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Foreground="#FF666666" FontSize="12" Text="{Binding ModelName}" />
                  </Grid>
                  <Grid Margin="0,6,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" Foreground="#FF999999">
                      <Run Text="MaxTokens:" /> <Run FontWeight="SemiBold" Text="{Binding MaxTokens}" /></TextBlock>
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#FF999999" Margin="12,0,0,0">
                      <Run Text="Temperature:" /> <Run FontWeight="SemiBold" Text="{Binding Temperature}" /></TextBlock>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border CornerRadius="2" Padding="6,2" Background="{Binding SourceColor}">
                      <TextBlock FontSize="10" Foreground="#FFFFFFFF" FontWeight="Medium" Text="{Binding SourceLabel}" />
                    </Border>
                    <Border Background="#FF9C27B0" CornerRadius="2" Padding="6,2" Margin="6,0,0,0" Visibility="{Binding SupportsVision, Converter={StaticResource BoolToVisibilityConverter}}">
                      <TextBlock Text="📷 视觉" FontSize="10" Foreground="#FFFFFFFF" FontWeight="Medium" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="⭐" Style="{StaticResource IconButton}" ToolTip="设为默认" Tag="{Binding}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" Click="OnSetDefaultClick" />
                  <Button Content="✏️" Style="{StaticResource IconButton}" ToolTip="编辑" Tag="{Binding}" Click="OnEditClick" />
                  <Button Content="🗑️" Style="{StaticResource IconButton}" ToolTip="删除" Margin="4,0,0,0" Tag="{Binding}" IsEnabled="{Binding IsUserConfig}" Click="OnDeleteClick" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="80" Height="36" Click="OnCloseClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>