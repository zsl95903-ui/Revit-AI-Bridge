<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.ToastNotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RevitAi Notification" Height="Auto" Width="320" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" ShowActivated="False" ShowInTaskbar="False" SizeToContent="Height" BorderThickness="0" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="ToastBorder" Storyboard.TargetProperty="Opacity" From="0" To="0.9" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
              <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </FrameworkElement.Triggers>
  <Border Name="ToastBorder" Background="#FF1A2B42" BorderBrush="#FFFFFFFF" BorderThickness="1" CornerRadius="2" Margin="10" Padding="15,10">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3" Color="Black" />
    </UIElement.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Canvas Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top" Grid.Column="0">
        <Path Stroke="#FFFFFFFF" StrokeThickness="1.5" Data="M10,2 A8,8 0 1 0 10,18A8,8 0 1 0 10,2" />
        <Line X1="10" Y1="6" X2="10" Y2="10" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="10" Y1="13" X2="10" Y2="14" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Canvas>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Name="TitleTextBlock" Text="提示" Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" FontFamily="Microsoft YaHei UI, Segoe UI" Margin="0,0,0,4" />
        <TextBlock Name="MessageTextBlock" Text="消息内容" Foreground="#FFFFFFFF" FontSize="12" FontFamily="Microsoft YaHei UI, Segoe UI" TextWrapping="Wrap" Opacity="0.9" />
      </StackPanel>
    </Grid>
  </Border>
</Window>