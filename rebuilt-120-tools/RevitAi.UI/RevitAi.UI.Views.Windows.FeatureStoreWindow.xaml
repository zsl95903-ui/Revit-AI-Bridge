<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.FeatureStoreWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitAi.UI.Views.Windows" Title="应用仓库 - 自定义您的 Ribbon 界面" Height="740" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ColorOpacityConverter x:Key="ColorOpacityConverter" Opacity="0.12" />
      <local:ColorOpacityConverter x:Key="ColorOpacityConverter2" Opacity="0.08" />
      <local:ColorBrushConverter x:Key="ColorBrushConverter" />
      <local:ColorConverter x:Key="ColorConverter" />
      <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
      <local:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter" />
      <local:StringNotEqualsVisibilityConverter x:Key="StringNotEqualsVisibilityConverter" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF1976D2" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SecondaryBrush" Color="#FFF5F5F5" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="FeatureCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="#FFBDBDBD" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="#FF000000" BlurRadius="12" ShadowDepth="3" Opacity="0.1" />
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
      </Style>
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="应用仓库" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
      <TextBlock Text="选择要在 RevitAi Ribbon 界面中显示的命令。更改将立即生效。" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="ℹ" FontSize="16" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock>
          <Run Text="已启用: " Foreground="{StaticResource TextBrush}" /> <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding EnabledCount, Mode=OneWay}" /> <Run Text=" / " Foreground="{StaticResource TextBrush}" /> <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text=" 个功能" Foreground="{StaticResource TextBrush}" /></TextBlock>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <TextBox FontSize="14" Padding="14,10,40,10" BorderThickness="0" Background="#FFFFFFFF" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                  <Setter Property="Border.CornerRadius" Value="6" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </TextBox>
          <TextBlock Text="搜索功能名称或说明..." FontSize="14" Foreground="#AAAAAAAA" VerticalAlignment="Center" Margin="14,0,40,0" IsHitTestVisible="False">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="" Binding="{Binding SearchText}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" IsHitTestVisible="False" />
        </Grid>
        <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBox}" VerticalAlignment="Center" Background="#FFFFFFFF" BorderThickness="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                <Setter Property="Border.CornerRadius" Value="6" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ComboBox>
        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Padding="16,10" FontSize="14" VerticalAlignment="Center" Content="{Binding SelectAllButtonText}" Command="{Binding SelectAllCommand}" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding FilteredFeatures}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource FeatureCard}" Width="200" Margin="0,0,16,16">
              <UIElement.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              </UIElement.InputBindings>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Row="0" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center" Background="{Binding ColorHex, Converter={StaticResource ColorOpacityConverter}}">
                    <UIElement.Effect>
                      <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="{Binding ColorHex, Converter={StaticResource ColorConverter}}" />
                    </UIElement.Effect>
                    <Grid>
                      <Image Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding IconPath}" Visibility="{Binding IconPath, Converter={StaticResource StringToVisibilityConverter}}" />
                      <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ColorHex, Converter={StaticResource ColorBrushConverter}}" Visibility="{Binding IconPath, Converter={StaticResource InverseStringToVisibilityConverter}}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="⚡" />
                            <Style.Triggers>
                              <DataTrigger Value="AI智能设计" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🤖" />
                              </DataTrigger>
                              <DataTrigger Value="房间与建筑方案" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🏠" />
                              </DataTrigger>
                              <DataTrigger Value="标高轴网与基准" Binding="{Binding Category}">
                                <Setter Property="Text" Value="📏" />
                              </DataTrigger>
                              <DataTrigger Value="墙梁柱板结构" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🏗️" />
                              </DataTrigger>
                              <DataTrigger Value="机电管线综合" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🔧" />
                              </DataTrigger>
                              <DataTrigger Value="尺寸标注与注释" Binding="{Binding Category}">
                                <Setter Property="Text" Value="📝" />
                              </DataTrigger>
                              <DataTrigger Value="视图图纸与出图" Binding="{Binding Category}">
                                <Setter Property="Text" Value="📄" />
                              </DataTrigger>
                              <DataTrigger Value="族类型参数管理" Binding="{Binding Category}">
                                <Setter Property="Text" Value="📦" />
                              </DataTrigger>
                              <DataTrigger Value="批量拆分与合并" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🔀" />
                              </DataTrigger>
                              <DataTrigger Value="表格数据互通" Binding="{Binding Category}">
                                <Setter Property="Text" Value="📊" />
                              </DataTrigger>
                              <DataTrigger Value="工具辅助系统" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🛠️" />
                              </DataTrigger>
                              <DataTrigger Value="路桥市政与基建" Binding="{Binding Category}">
                                <Setter Property="Text" Value="🌉" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight" Text="{Binding DisplayName}">
                    <FrameworkElement.ToolTip>
                      <ToolTip MaxWidth="300" Content="{Binding Description}" />
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                  <CheckBox Grid.Column="2" VerticalAlignment="Center" Width="24" Height="24" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <Border Grid.Row="2" Padding="7,6" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,6" Background="{Binding ColorHex, Converter={StaticResource ColorOpacityConverter2}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Category}" Foreground="{Binding ColorHex, Converter={StaticResource ColorBrushConverter}}" />
                    <TextBlock Text=" · " FontSize="12" Foreground="{Binding ColorHex, Converter={StaticResource ColorBrushConverter}}" Visibility="{Binding SubCategory, Converter={StaticResource StringNotEqualsVisibilityConverter}, ConverterParameter=其他}" />
                    <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding SubCategory}" Foreground="{Binding ColorHex, Converter={StaticResource ColorBrushConverter}}" Visibility="{Binding SubCategory, Converter={StaticResource StringNotEqualsVisibilityConverter}, ConverterParameter=其他}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" Padding="24,16" CornerRadius="10" Margin="0,24,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Padding="24,10" FontSize="14" FontWeight="SemiBold" Click="OnSaveAndApplyClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>