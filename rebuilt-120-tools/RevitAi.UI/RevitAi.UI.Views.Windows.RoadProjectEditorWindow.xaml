<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.RoadProjectEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="编辑道路项目" Height="950" Width="700" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SecondaryBrush" Color="#FFF5F5F5" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
      <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="UnselectedBorderBrush" Color="#FFE0E0E0" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <Style x:Key="SelectableBorderStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="8">
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource UnselectedBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="编辑道路项目" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
      <TextBlock Text="设置项目名称、输入道路数据并生成中心线曲线。" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,0,20">
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="项目名称" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
            <TextBox FontSize="14" Padding="8" Height="36" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Border>
        <TextBlock Text="数据输入（请选择其中一种方式）" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <RadioButton Style="{StaticResource SelectableBorderStyle}" GroupName="DataSource" Margin="0,0,8,0" Padding="16" IsChecked="{Binding IsCheckedStationElevation}">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="桩号位置和高程表" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="输入数据 →" Style="{StaticResource PrimaryButton}" Width="120" Height="32" Margin="16,0,0,0" Command="{Binding InputStationElevationCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
              </Grid>
              <TextBlock Text="直接输入桩号、X/Y坐标和高程数据，适合简单的道路中心线。" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Text="✓ 已输入数据" FontSize="12" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding HasStationElevationData, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SelectableBorderStyle}" GroupName="DataSource" Grid.Column="1" Margin="8,0,0,0" Padding="16" IsChecked="{Binding IsCheckedCurve}">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="平纵曲线表" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="输入数据 →" Style="{StaticResource PrimaryButton}" Width="120" Height="32" Margin="16,0,0,0" Command="{Binding InputHorizontalVerticalCurveCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
              </Grid>
              <TextBlock Text="通过平曲线和纵曲线参数生成道路中心线，适合专业道路工程设计。" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Text="✓ 已输入数据" FontSize="12" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding HasCurveData, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </RadioButton>
        </Grid>
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="参数设置" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
            <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="原点相对坐标（米）-设置 Revit 原点在表格数据中的相对位置" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="X:" FontSize="14" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" FontSize="14" Padding="8" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center" Text="{Binding OriginOffsetX, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="Y:" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <TextBox Grid.Column="3" FontSize="14" Padding="8" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center" Text="{Binding OriginOffsetY, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="4" Text="Z:" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <TextBox Grid.Column="5" FontSize="14" Padding="8" Height="36" VerticalContentAlignment="Center" Text="{Binding OriginOffsetZ, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </StackPanel>
            </Border>
            <CheckBox Content="创建桩号标注" FontSize="14" Margin="0,8,0,12" IsChecked="{Binding CreateStationAnnotations}" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="标注间距 (米)" FontSize="14" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" FontSize="14" Padding="8" Height="32" Text="{Binding AnnotationInterval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CreateStationAnnotations}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="生成状态" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12" />
            <TextBlock Text="✓ 曲线已生成" FontSize="14" Foreground="{StaticResource SuccessBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
      <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="保存" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,12,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
        <Button Content="绘制曲线" Style="{StaticResource PrimaryButton}" Width="120" Height="36" FontWeight="SemiBold" Margin="0,0,12,0" Command="{Binding DrawCenterlineCommand}" IsEnabled="{Binding CanDrawCenterline}" />
        <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Command="{Binding CloseCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="正在处理..." FontSize="16" Foreground="#FFFFFFFF" Margin="0,0,0,8" />
      </StackPanel>
    </Border>
  </Grid>
</Window>