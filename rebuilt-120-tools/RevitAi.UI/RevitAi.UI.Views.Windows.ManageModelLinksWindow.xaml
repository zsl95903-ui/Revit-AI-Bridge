<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.ManageModelLinksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="管理链接模型" Height="700" Width="1100" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows;assembly=RevitAi.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF1976D2" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SecondaryBrush" Color="#FFF5F5F5" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFF44336" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFD32F2F" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="ModifiedRowStyle" TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding HasUnsavedChanges}">
            <Setter Property="Background" Value="#FFF3E5" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding HasUnsavedChanges}">
            <Setter Property="Background" Value="#FFFFFFFF" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernDataGrid" TargetType="{x:Type DataGrid}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="DataGrid.RowBackground" Value="#FFFFFFFF" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#FAFAFA" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
        <Setter Property="DataGrid.CanUserAddRows" Value="False" />
        <Setter Property="DataGrid.CanUserDeleteRows" Value="False" />
        <Setter Property="DataGrid.SelectionMode" Value="Extended" />
        <Setter Property="DataGrid.IsReadOnly" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="DataGrid.RowStyle" Value="{StaticResource ModifiedRowStyle}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="管理链接模型" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
      <TextBlock Text="查看和管理当前项目中的所有链接模型。支持批量重新载入、卸载和删除操作。" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Margin="0,0,16,0">
          <Run Text="链接数量: " Foreground="{StaticResource TextBrush}" /> <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding LinkCount, Mode=OneWay}" /></TextBlock>
        <TextBlock>
          <Run Text="已选中: " Foreground="{StaticResource TextBrush}" /> <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding SelectedCount, Mode=OneWay}" /></TextBlock>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
      <WrapPanel Orientation="Horizontal">
        <CheckBox Content="全选/反选" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="13" ToolTip="勾选此框可全选或取消全选所有链接" IsChecked="{Binding SelectAll}" />
        <Button Content="🔄 重新载入全部" Style="{StaticResource PrimaryButton}" Width="130" Height="32" Margin="0,0,8,0" Command="{Binding ReloadAllCommand}" />
        <Button Content="📥 重新载入选中" Style="{StaticResource PrimaryButton}" Width="130" Height="32" Margin="0,0,8,0" Command="{Binding ReloadSelectedCommand}" />
        <Button Content="🔓 卸载选中" Style="{StaticResource SecondaryButton}" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding UnloadSelectedCommand}" />
        <Button Content="🗑️ 删除选中" Style="{StaticResource DangerButton}" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding DeleteSelectedCommand}" />
        <Button Content="🔃 刷新列表" Style="{StaticResource SecondaryButton}" Width="110" Height="32" Command="{Binding RefreshCommand}" />
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="#FFFFFFFF">
      <DataGrid Style="{StaticResource ModernDataGrid}" HeadersVisibility="Column" ItemsSource="{Binding ModelLinks}" SelectedItem="{Binding SelectedLink}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="选中" Width="50">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" ClickMode="Press" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="名称" Width="200" IsReadOnly="True" Binding="{Binding Name}" />
          <DataGridTemplateColumn Header="文件路径" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4" TextTrimming="CharacterEllipsis" Text="{Binding FilePath}" ToolTip="{Binding FilePath}" />
                  <Button Grid.Column="1" Content="..." Width="30" Height="24" Margin="4,0,0,0" FontSize="12" Padding="0" ToolTip="浏览并替换链接文件" Command="{Binding DataContext.SelectFilePathCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="载入" Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" ClickMode="Press" IsChecked="{Binding IsLoadedDesired, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="状态" Width="80" IsReadOnly="True" Binding="{Binding Status}" />
          <DataGridTemplateColumn Header="X (m)" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox VerticalAlignment="Center" Margin="4" BorderThickness="0" Background="#00FFFFFF" HorizontalAlignment="Right" Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Y (m)" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox VerticalAlignment="Center" Margin="4" BorderThickness="0" Background="#00FFFFFF" HorizontalAlignment="Right" Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Z (m)" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox VerticalAlignment="Center" Margin="4" BorderThickness="0" Background="#00FFFFFF" HorizontalAlignment="Right" Text="{Binding PositionZ, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="旋转 (°)" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox VerticalAlignment="Center" Margin="4" BorderThickness="0" Background="#00FFFFFF" HorizontalAlignment="Right" Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" Padding="16,12" CornerRadius="8" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
          <Run Text="💡 提示：在列表中直接修改坐标、旋转角度，或勾选/取消「载入」列。然后点击「保存修改」应用所有更改。" />
        </TextBlock>
        <Button Content="💾 保存修改" Style="{StaticResource PrimaryButton}" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding SaveChangesCommand}" />
        <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="80" Height="32" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>