<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="RevitAi.UI.Views.Controls.AIChatControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitAi.UI.Views.Controls" xmlns:converters="clr-namespace:RevitAi.UI.Converters" xmlns:behaviors="clr-namespace:RevitAi.UI.Behaviors" Background="#FFF9F9F9">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <converters:ButtonWidthToVisibilityConverter x:Key="ButtonWidthToVisibilityConverter" Threshold="80" />
      <converters:ItemCountToVisibilityConverter x:Key="ItemCountToVisibilityConverter" />
      <DataTemplate x:Key="UserMessageTemplate">
        <Grid Margin="5,0,5,10">
          <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
            <Border MaxWidth="450" Padding="12,10" CornerRadius="12,12,0,12" Background="#FF0078D4" Margin="10,0,0,0">
              <TextBox IsReadOnly="True" BorderThickness="0" Background="#00FFFFFF" Foreground="#FFFFFFFF" FontSize="14" FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei, 宋体" TextWrapping="Wrap" VerticalAlignment="Top" behaviors:ScrollViewerBehavior.PropagateMouseWheel="True" Text="{Binding Content, Mode=OneWay}" />
            </Border>
            <ItemsControl Margin="0,4,10,0" HorizontalAlignment="Right" ItemsSource="{Binding Attachments}" Visibility="{Binding Attachments, Converter={StaticResource NullToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📎" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="#FF333333" Text="{Binding FileName}" />
                      <TextBlock FontSize="10" VerticalAlignment="Center" Foreground="#FF999999" Margin="6,0,0,0" Text="{Binding FileSizeDisplay}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AIMessageTemplate">
        <Grid Margin="5,0,5,10">
          <Border HorizontalAlignment="Left" MaxWidth="450" Padding="12,10" CornerRadius="12,12,12,0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,10,0">
            <local:MarkdownTextBlock MaxWidth="426" Foreground="#FF333333" FontSize="14" FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei, 宋体" Markdown="{Binding Content, Mode=OneWay}" />
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AITypingTemplate">
        <Grid Margin="5,0,5,10">
          <Border HorizontalAlignment="Left" Padding="12,10" CornerRadius="12,12,12,0" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="●" Foreground="#FF0078D4" FontSize="14" Margin="0,0,2,0" VerticalAlignment="Center">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Dot1Scale" ScaleX="1" ScaleY="1" CenterX="7" CenterY="7" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="TextBlock.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Dot1Scale" Storyboard.TargetProperty="ScaleX" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                        <DoubleAnimation Storyboard.TargetName="Dot1Scale" Storyboard.TargetProperty="ScaleY" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
              </TextBlock>
              <TextBlock Text="●" Foreground="#FF0078D4" FontSize="14" Margin="0,0,2,0" VerticalAlignment="Center">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Dot2Scale" ScaleX="1" ScaleY="1" CenterX="7" CenterY="7" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="TextBlock.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.17">
                        <DoubleAnimation Storyboard.TargetName="Dot2Scale" Storyboard.TargetProperty="ScaleX" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                        <DoubleAnimation Storyboard.TargetName="Dot2Scale" Storyboard.TargetProperty="ScaleY" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
              </TextBlock>
              <TextBlock Text="●" Foreground="#FF0078D4" FontSize="14" Margin="0,0,0,0" VerticalAlignment="Center">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Dot3Scale" ScaleX="1" ScaleY="1" CenterX="7" CenterY="7" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="TextBlock.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.34">
                        <DoubleAnimation Storyboard.TargetName="Dot3Scale" Storyboard.TargetProperty="ScaleX" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                        <DoubleAnimation Storyboard.TargetName="Dot3Scale" Storyboard.TargetProperty="ScaleY" From="1" To="0.6" Duration="0:0:0.5" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AIThinkingTemplate">
        <Grid Margin="5,0,5,10">
          <Border HorizontalAlignment="Left" MaxWidth="450" Padding="12,10" CornerRadius="12,12,12,0" Background="#FFF5E6" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="🤔 " FontSize="14" VerticalAlignment="Top" Foreground="#FFB36600" Margin="0,0,4,0" />
              <local:MarkdownTextBlock Grid.Column="1" MaxWidth="406" Foreground="#FF666666" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" FontStyle="Italic" Markdown="{Binding Content, Mode=OneWay}" />
            </Grid>
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AIToolCallTemplate">
        <Grid Margin="5,0,5,10">
          <Border HorizontalAlignment="Left" MaxWidth="450" Padding="12,10" CornerRadius="12,12,12,0" Background="#F0F8FF" BorderBrush="#FF0078D4" BorderThickness="1" Margin="0,0,10,0">
            <TextBox IsReadOnly="True" BorderThickness="0" Background="#00FFFFFF" Foreground="#FF333333" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" TextWrapping="Wrap" VerticalAlignment="Top" behaviors:ScrollViewerBehavior.PropagateMouseWheel="True" Text="{Binding Content, Mode=OneWay}" />
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AIToolResultTemplate">
        <Grid Margin="5,0,5,10">
          <StackPanel Orientation="Vertical" Margin="0,0,10,0">
            <Border HorizontalAlignment="Left" MaxWidth="450" Padding="12,10" CornerRadius="12,12,12,0" Background="#E8F5E9" BorderBrush="#FF4CAF50" BorderThickness="1">
              <local:MarkdownTextBlock MaxWidth="426" Foreground="#FF2E7D32" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" Markdown="{Binding Content, Mode=OneWay}" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button HorizontalAlignment="Left" Padding="10,6" FontSize="12" Background="#FF0078D4" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SaveCodeSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SavableCode}" Visibility="{Binding SavableCode, Converter={StaticResource NullToVisibilityConverter}}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="UIElement.Opacity" Value="0.6" />
                        <Setter Property="FrameworkElement.Cursor" Value="Wait" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF106EBE" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Name="SaveIconText" Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Name="LoadingSpinner" Text="⏳" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
                    <UIElement.RenderTransform>
                      <RotateTransform x:Name="SpinnerTransform" CenterX="6" CenterY="6" />
                    </UIElement.RenderTransform>
                    <FrameworkElement.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </FrameworkElement.Triggers>
                  </TextBlock>
                  <TextBlock Text="保存为代码片段" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AIToolErrorTemplate">
        <Grid Margin="5,0,5,10">
          <Border HorizontalAlignment="Left" MaxWidth="450" Padding="12,10" CornerRadius="12,12,12,0" Background="#FFEBEE" BorderBrush="#FFEF5350" BorderThickness="1" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="❌ " FontSize="14" VerticalAlignment="Top" Foreground="#FFD32F2F" Margin="0,0,4,0" />
              <local:MarkdownTextBlock Grid.Column="1" MaxWidth="406" Foreground="#FFC62828" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" Markdown="{Binding Content, Mode=OneWay}" />
            </Grid>
          </Border>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                  <Border Name="Border" Background="#00FFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0" Padding="0">
                    <Grid Background="#00FFFFFF">
                      <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,12" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="TabItem.IsSelected" Value="True">
                      <Setter TargetName="Border" Property="Border.BorderBrush" Value="#FF0078D4" />
                      <Setter TargetName="Border" Property="Border.BorderThickness" Value="0,0,0,2" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="Border" Property="Border.Background" Value="#FFF5F5F5" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <TabItem Header="   💬 AI 对话   ">
        <ScrollViewer Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="15,10,15,15">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplateSelector>
              <local:MessageTemplateSelector UserTemplate="{StaticResource UserMessageTemplate}" AITemplate="{StaticResource AIMessageTemplate}" AITypingTemplate="{StaticResource AITypingTemplate}" AIThinkingTemplate="{StaticResource AIThinkingTemplate}" AIToolCallTemplate="{StaticResource AIToolCallTemplate}" AIToolResultTemplate="{StaticResource AIToolResultTemplate}" AIToolErrorTemplate="{StaticResource AIToolErrorTemplate}" />
            </ItemsControl.ItemTemplateSelector>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Header=" 📋 代码片段库 ">
        <local:CodeSnippetLibraryControl DataContext="{Binding CodeSnippetLibraryViewModel}" />
      </TabItem>
      <TabItem Header="  🛒 代码市场  ">
        <local:CodeMarketControl DataContext="{Binding CodeMarketViewModel}" />
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" Padding="15,10,15,15" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="0,0,0,8" BorderBrush="#FFF0F0F0" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="模型:" VerticalAlignment="Center" Foreground="#FF666666" FontSize="12" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" MinWidth="200" MaxWidth="350" Height="28" FontSize="12" Padding="8,0" VerticalContentAlignment="Center" ItemsSource="{Binding AvailableAIConfigs}" SelectedItem="{Binding SelectedAIConfig}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{Binding SourceColor}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{Binding DisplayName}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#FF999999" Margin="6,0,0,0" Text="{Binding PriceDisplayText}" Visibility="{Binding PriceDisplayText, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Border Grid.Column="3" CornerRadius="2" Padding="3,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{Binding VisionColor}" Visibility="{Binding VisionLabel, Converter={StaticResource NullToVisibilityConverter}}">
                      <TextBlock FontSize="8" Foreground="#FFFFFFFF" FontWeight="Medium" Text="{Binding VisionLabel}" />
                    </Border>
                    <Border Grid.Column="4" CornerRadius="2" Padding="3,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{Binding SourceColor}">
                      <TextBlock FontSize="8" Foreground="#FFFFFFFF" FontWeight="Medium" Text="{Binding SourceLabel}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" MinWidth="36" Height="28" Margin="12,0,0,0" FontSize="12" Padding="0" HorizontalAlignment="Left" ToolTip="AI 提供商管理" Command="{Binding ManageAIProvidersCommand}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="Background" Value="#FFF0F0F0" />
                  <Setter Property="Foreground" Value="#FF666666" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="BorderBrush" Value="#FFCCCCCC" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Background" Value="#FFF5F5F5" />
                      <Setter Property="Foreground" Value="#FFAAAAAA" />
                      <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="配置管理" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding ActualWidth, Converter={StaticResource ButtonWidthToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" MinWidth="36" Height="28" Margin="8,0,0,0" FontSize="12" Padding="0" HorizontalAlignment="Left" ToolTip="新建会话" Command="{Binding NewSessionCommand}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="Background" Value="#FFF0F0F0" />
                  <Setter Property="Foreground" Value="#FF666666" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="BorderBrush" Value="#FFCCCCCC" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Background" Value="#FFF5F5F5" />
                      <Setter Property="Foreground" Value="#FFAAAAAA" />
                      <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="➕" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="新建会话" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding ActualWidth, Converter={StaticResource ButtonWidthToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" MinWidth="36" Height="28" Margin="8,0,0,0" FontSize="12" Padding="0" HorizontalAlignment="Left" ToolTip="会话管理" Command="{Binding ManageSessionsCommand}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="Background" Value="#FFF0F0F0" />
                  <Setter Property="Foreground" Value="#FF666666" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="BorderBrush" Value="#FFCCCCCC" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Background" Value="#FFF5F5F5" />
                      <Setter Property="Foreground" Value="#FFAAAAAA" />
                      <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="📚" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="会话管理" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding ActualWidth, Converter={StaticResource ButtonWidthToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="8,6,8,6" Visibility="{Binding Attachments.Count, Converter={StaticResource ItemCountToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="附件" FontSize="12" Foreground="#FF999999" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Attachments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="#FF333333" Text="{Binding FileName}" ToolTip="{Binding FileSizeDisplay}" />
                      <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="#FF999999" Margin="8,0,0,0" Text="{Binding FileSizeDisplay}" />
                      <Button Content="✕" Margin="8,0,0,0" Padding="4,2" Background="#00FFFFFF" BorderThickness="0" FontSize="14" Foreground="#FF999999" Cursor="Hand" ToolTip="移除附件" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding AttachmentId}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF44336" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </Border>
        <Grid Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="6" Background="#FFFFFFFF">
            <TextBox Name="InputTextBox" Padding="10,8" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="Wrap" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnKeyDown" />
          </Border>
          <Button Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0" ToolTip="上传图片或文件（仅支持 vision 模型）" Command="{Binding AttachFileCommand}" Visibility="{Binding AttachFileButtonVisible}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="Foreground" Value="#FF666666" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#FFCCCCCC" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F0F0" />
                    <Setter Property="Foreground" Value="#FF0078D4" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Text="📎" FontSize="18" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="2" Width="85" Height="36" Margin="8,0,0,0" FontSize="13" Padding="0" Command="{Binding Path=PrimaryButtonCommand}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FF0078D4" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <UIElement.Effect>
                          <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#40000000" Opacity="0.3" />
                        </UIElement.Effect>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsProcessing, FallbackValue=False}">
                    <Setter Property="Background" Value="#FFF44336" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="False" Binding="{Binding IsProcessing, FallbackValue=False}" />
                      <Condition Value="True" Binding="{Binding IsEnabled, FallbackValue=True}" />
                    </MultiDataTrigger.Conditions>
                    <TriggerBase.EnterActions>
                      <BeginStoryboard Name="SendHoverStoryboard">
                        <Storyboard>
                          <ColorAnimation Storyboard.TargetProperty="Background.Color" To="#FF106EBE" Duration="0:0:0.2" />
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.EnterActions>
                    <TriggerBase.ExitActions>
                      <StopStoryboard BeginStoryboardName="SendHoverStoryboard" />
                      <BeginStoryboard>
                        <Storyboard>
                          <ColorAnimation Storyboard.TargetProperty="Background.Color" To="#FF0078D4" Duration="0:0:0.2" />
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.ExitActions>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="True" Binding="{Binding IsProcessing, FallbackValue=False}" />
                      <Condition Value="True" Binding="{Binding IsEnabled, FallbackValue=True}" />
                    </MultiDataTrigger.Conditions>
                    <TriggerBase.EnterActions>
                      <BeginStoryboard Name="StopHoverStoryboard">
                        <Storyboard>
                          <ColorAnimation Storyboard.TargetProperty="Background.Color" To="#FFD32F2F" Duration="0:0:0.2" />
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.EnterActions>
                    <TriggerBase.ExitActions>
                      <StopStoryboard BeginStoryboardName="StopHoverStoryboard" />
                      <BeginStoryboard>
                        <Storyboard>
                          <ColorAnimation Storyboard.TargetProperty="Background.Color" To="#FFF44336" Duration="0:0:0.2" />
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.ExitActions>
                  </MultiDataTrigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFCCCCCC" />
                    <Setter Property="Foreground" Value="#FFAAAAAA" />
                    <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel Orientation="Horizontal" Margin="12,0">
              <TextBlock>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="False" Binding="{Binding IsProcessing, FallbackValue=False}">
                        <Setter Property="Text" Value="发送 ↵" />
                      </DataTrigger>
                      <DataTrigger Value="True" Binding="{Binding IsProcessing, FallbackValue=False}">
                        <Setter Property="Text" Value="停止 ■" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>