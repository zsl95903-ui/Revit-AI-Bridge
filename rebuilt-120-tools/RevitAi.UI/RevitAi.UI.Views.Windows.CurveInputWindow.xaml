<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.CurveInputWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="平纵曲线表输入" Height="700" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="平纵曲线表输入" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
    <TabControl Grid.Row="1" BorderThickness="0" Background="#00FFFFFF">
      <TabItem Header="平曲线表" Padding="16,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="平曲线交点数据" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" SelectionMode="Extended" SelectionUnit="FullRow" Height="330" GridLinesVisibility="All" HeadersVisibility="Column" ItemsSource="{Binding HorizontalCurvePoints}" SelectionChanged="HorizontalDataGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="交点号" Width="80" Binding="{Binding IpNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="桩号" Width="120" Binding="{Binding StationDisplay}" />
                <DataGridTextColumn Header="X坐标(m)" Width="100" Binding="{Binding X, StringFormat=F3}" />
                <DataGridTextColumn Header="Y坐标(m)" Width="100" Binding="{Binding Y, StringFormat=F3}" />
                <DataGridTextColumn Header="半径(m)" Width="100" Binding="{Binding Radius, StringFormat=F2}" />
                <DataGridTextColumn Header="缓和曲线长Ls1(m)" Width="110" Binding="{Binding Ls1, StringFormat=F2}" />
                <DataGridTextColumn Header="缓和曲线长Ls2(m)" Width="110" Binding="{Binding Ls2, StringFormat=F2}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="导入 Excel" Style="{StaticResource SecondaryButton}" Width="120" Height="36" Margin="0,0,12,0" Command="{Binding ImportHorizontalCurveCommand}" />
              <Button Content="添加示例数据" Style="{StaticResource SecondaryButton}" Width="120" Height="36" Margin="0,0,12,0" Command="{Binding AddSampleDataCommand}" />
              <Button Content="切换X/Y" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,12,0" Command="{Binding SwapHorizontalXYCommand}" />
              <Button Content="添加行" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,12,0" Command="{Binding AddHorizontalRowCommand}" />
              <Button Content="删除选中行" Style="{StaticResource SecondaryButton}" Width="120" Height="36" Margin="0,0,12,0" Command="{Binding DeleteSelectedHorizontalRowsCommand}" />
              <Button Content="清空数据" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Command="{Binding ClearHorizontalDataCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="纵曲线表" Padding="16,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="竖曲线变坡点数据" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" SelectionMode="Extended" SelectionUnit="FullRow" Height="330" GridLinesVisibility="All" HeadersVisibility="Column" ItemsSource="{Binding VerticalCurvePoints}" SelectionChanged="VerticalDataGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="桩号" Width="120" Binding="{Binding StationDisplay}" />
                <DataGridTextColumn Header="高程(m)" Width="120" Binding="{Binding Elevation, StringFormat=F3}" />
                <DataGridTextColumn Header="半径(m)" Width="120" Binding="{Binding Radius, StringFormat=F0}" />
                <DataGridTextColumn Header="类型" IsReadOnly="True" Width="80" Binding="{Binding CurveType}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="导入 Excel" Style="{StaticResource SecondaryButton}" Width="120" Height="36" Margin="0,0,12,0" Command="{Binding ImportVerticalCurveCommand}" />
              <Button Content="添加行" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,12,0" Command="{Binding AddVerticalRowCommand}" />
              <Button Content="删除选中行" Style="{StaticResource SecondaryButton}" Width="120" Height="36" Margin="0,0,12,0" Command="{Binding DeleteSelectedVerticalRowsCommand}" />
              <Button Content="清空数据" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Command="{Binding ClearVerticalDataCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2">
      <Border Background="#FFF5F5F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="100" Height="40" Margin="0,0,12,0" Command="{Binding CloseCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
        <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="120" Height="40" FontWeight="SemiBold" Command="{Binding CompleteCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>