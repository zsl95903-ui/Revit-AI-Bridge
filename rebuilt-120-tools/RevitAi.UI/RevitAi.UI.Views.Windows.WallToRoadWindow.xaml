<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.WallToRoadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="从墙生成道路网络" Height="750" Width="400" WindowStartupLocation="Manual" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="ParamTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="60" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="TextBox.TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
      </Style>
      <Style x:Key="ParamLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="ParamUnit" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#FF999999" />
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#FFBDBDBD" />
            <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="#FFBDBDBD" />
            <Setter Property="BorderBrush" Value="#FFE0E0E0" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="从墙生成道路网络" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
    <TextBlock Grid.Row="0" Text="根据选择的墙元素创建车道、人行道和路沿石" FontSize="13" Foreground="#FF666666" Margin="0,28,0,16" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. 选择墙（框选或单选）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Button Content="选择墙" Style="{StaticResource SecondaryButton}" Width="200" Height="36" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding SelectWallsCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
        <TextBlock FontSize="13" Margin="0,0,0,16" Text="{Binding SelectedWallCount, StringFormat=已选择 {0} 道墙}" />
        <TextBlock Text="2. 参数设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="道路" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="默认宽度" Style="{StaticResource ParamLabel}" />
              <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding DefaultRoadWidth, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
              <TextBlock Grid.Column="4" Text="路口倒角" Style="{StaticResource ParamLabel}" />
              <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding FilletRadius, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="6" Text="米" Style="{StaticResource ParamUnit}" />
            </Grid>
            <TextBlock Text="在墙的「注释」参数中可设置单条路的宽度（米），未设置则用默认宽度" FontSize="11" Foreground="#FF999999" Margin="0,0,0,6" TextWrapping="Wrap" />
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateSidewalks}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="人行道" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="宽度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding SidewalkWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="路沿石" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding CurbWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="毫米" Style="{StaticResource ParamUnit}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateCenterMarkings}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="路中心标线" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="标线宽度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding CenterMarkingWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="毫米" Style="{StaticResource ParamUnit}" />
                  <CheckBox Grid.Column="3" Content="双线" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="{Binding IsCenterMarkingDoubleLine}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateCrosswalks}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="人行横道" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="线宽" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding CrosswalkLineWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="毫米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="线间隔" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding CrosswalkLineGap, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="毫米" Style="{StaticResource ParamUnit}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="线长" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding CrosswalkLength, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="距停止线" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding CrosswalkDistanceFromMarking, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="米" Style="{StaticResource ParamUnit}" />
                </Grid>
                <TextBlock Text="在路口标线收缩处自动生成白色横道线" FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateLaneMarkings}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="同向车行道分界线" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="车道宽度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding LaneWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="线条宽度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding LaneMarkingWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="毫米" Style="{StaticResource ParamUnit}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="实线长度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding LaneMarkingSolidLength, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="间隔长度" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="5" Style="{StaticResource ParamTextBox}" Text="{Binding LaneMarkingGapLength, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="米" Style="{StaticResource ParamUnit}" />
                </Grid>
                <TextBlock Text="生成道路边缘实线、车道间虚线及停止线处分隔线" FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateDirectionArrows}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="指向箭头" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="箭头间距" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding ArrowSpacing, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                  <TextBlock Grid.Column="4" Text="箭头大小" Style="{StaticResource ParamLabel}" />
                  <ComboBox Grid.Column="5" Width="70" Height="24" Margin="4,0,0,0" SelectedIndex="{Binding ArrowSizeIndex}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}">
                    <ComboBoxItem Content="3米" />
                    <ComboBoxItem Content="6米" />
                    <ComboBoxItem Content="9米" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="在道路中心线上按间距绘制指向箭头" FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" IsChecked="{Binding CreateSiteFloor}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
                  <TextBlock Text="场地" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="外扩距离" Style="{StaticResource ParamLabel}" />
                  <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}" Text="{Binding SiteFloorExtension, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="米" Style="{StaticResource ParamUnit}" />
                </Grid>
                <TextBlock Text="生成包围道路网络的场地楼板，道路和人行道区域为空心" FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
              <CheckBox Content="删除原始墙" FontSize="13" VerticalAlignment="Center" IsChecked="{Binding DeleteOriginalWalls}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Background="#FFF5F5F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding StatusMessage}" />
            <StackPanel Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="0,0,0,8">
                <TextBlock FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ProgressText}" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}">
                      <Binding Path="CurrentProgress" />
                      <Binding Path="TotalProgress" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
              <ProgressBar Height="8" Minimum="0" Background="#FFE0E0E0" Foreground="{StaticResource PrimaryBrush}" Maximum="{Binding TotalProgress}" Value="{Binding CurrentProgress}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="100" Height="40" Margin="0,0,12,0" Command="{Binding CloseCommand}" Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
      <Button Content="创建道路" Style="{StaticResource PrimaryButton}" Width="120" Height="40" FontWeight="SemiBold" Command="{Binding CreateRoadCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
    </StackPanel>
  </Grid>
</Window>