<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.CreateSubgradeModelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitAi.UI.Views.Windows" xmlns:converters="clr-namespace:RevitAi.UI.Converters" Title="道路建模" Height="750" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:AncillaryStructureTypeConverter x:Key="StructureTypeConverter" />
      <converters:AncillaryPositionTypeConverter x:Key="PositionTypeConverter" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0277BD" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE1F5FE" />
      <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF01579B" />
      <SolidColorBrush x:Key="TextBrush" Color="#DD000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <SolidColorBrush x:Key="SectionHeaderBrush" Color="#FF0277BD" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF5F5F5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style x:Key="SectionBorder" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="Border.Padding" Value="12" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="道路建模" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
    <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="选择路线:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" DisplayMemberPath="Name" Padding="6" FontSize="13" ItemsSource="{Binding RoadProjects}" SelectedItem="{Binding SelectedRoadProject}" />
        <Button Grid.Column="2" Content="刷新" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding LoadRoadProjectsCommand}" />
        <Button Grid.Column="3" Content="管理路线" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding NavigateToRoadProjectManagementCommand}" />
      </Grid>
    </Border>
    <TabControl Grid.Row="2" BorderThickness="0" Padding="0" SelectionChanged="MainTabControl_SelectionChanged">
      <TabItem Header="路面结构设计">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,6,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="路基层定义" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,8" />
                <DockPanel Dock="Top" Margin="0,0,0,8">
                  <Button Content="复制到其他路线" Style="{StaticResource SmallButton}" DockPanel.Dock="Right" Command="{Binding CopyLayersToOtherRoadsCommand}" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="添加层" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding AddLayerCommand}" />
                    <Button Content="删除选中" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding RemoveSelectedLayerCommand}" />
                    <Button Content="上移" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding MoveLayerUpCommand}" />
                    <Button Content="下移" Style="{StaticResource SmallButton}" Command="{Binding MoveLayerDownCommand}" />
                  </StackPanel>
                </DockPanel>
                <ListBox ItemsSource="{Binding SubgradeLayers}" SelectedItem="{Binding SelectedLayer}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="2">
                        <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Margin="0,0,8,0">
                          <Shape.Fill>
                            <SolidColorBrush Color="{Binding Color}" />
                          </Shape.Fill>
                        </Rectangle>
                        <TextBlock FontWeight="Medium" Margin="0,0,12,0" Text="{Binding Name}" />
                        <TextBlock Foreground="#99666666" Margin="0,0,8,0">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="增量:{0}mm">
                              <Binding Path="WidthIncrement" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Foreground="#99666666" Margin="0,0,8,0">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                              <Binding Path="IncrementTypeDisplay" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Foreground="#99666666" Margin="0,0,8,0" Text="{Binding SlopeRatio, StringFormat=坡度:1:{0}}" />
                        <TextBlock Foreground="#99666666" Text="{Binding Height, StringFormat=高:{0}mm}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="层参数编辑" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,12" />
                <Grid DataContext="{Binding SelectedLayer}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="层名称:" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Padding="4" Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="宽度增量:" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding WidthIncrement, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,4,8" />
                  <ComboBox Grid.Row="1" Grid.Column="3" Width="80" Margin="0,0,0,8" SelectedIndex="{Binding IncrementTypeIndex, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="单侧" />
                    <ComboBoxItem Content="两侧" />
                  </ComboBox>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="边坡坡度:" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox Grid.Row="2" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding SlopeRatio, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="1:n" VerticalAlignment="Center" Margin="4,0,0,8" Grid.ColumnSpan="2" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="层高:" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox Grid.Row="3" Grid.Column="1" Padding="4" Margin="0,0,0,8" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,8" Grid.ColumnSpan="2" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" FontSize="10" Foreground="#99999966" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="顶层宽度增量：相对路面宽度" />
                    <LineBreak />
                    <Run Text="下层宽度增量：相对上层底宽度" />
                  </TextBlock>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="断面预览" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,4" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="滚轮缩放 · 左键/中键拖动 · 双击适应窗口" VerticalAlignment="Center" FontSize="11" Foreground="#99666666" />
                <TextBlock Text="  路面预览宽度:" VerticalAlignment="Center" Margin="12,0,8,0" FontSize="11" />
                <TextBox Width="70" VerticalAlignment="Center" FontSize="11" Text="{Binding PreviewRoadWidth, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="m" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" Foreground="#999999" />
              </StackPanel>
              <Canvas Name="PreviewCanvas" Background="#FFFAFAFA" ClipToBounds="True" MouseWheel="PreviewCanvas_MouseWheel" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp" PreviewMouseDown="PreviewCanvas_PreviewMouseDown" PreviewMouseUp="PreviewCanvas_PreviewMouseUp" MouseMove="PreviewCanvas_MouseMove" SizeChanged="PreviewCanvas_SizeChanged">
                <Canvas Name="PreviewContent" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                  <UIElement.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                      <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0" />
                    </TransformGroup>
                  </UIElement.RenderTransform>
                  <ItemsControl ItemsSource="{Binding LayerPreviewData}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Polygon Stroke="#FF555555" Points="{Binding Points}" StrokeThickness="{Binding StrokeThickness}">
                          <Shape.Fill>
                            <SolidColorBrush Opacity="0.7" Color="{Binding FillColor}" />
                          </Shape.Fill>
                        </Polygon>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Canvas>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="平面布置">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,6,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="桩号参数定义" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,8" />
              <Border DockPanel.Dock="Bottom" Background="#FFF0F7FF" BorderBrush="#FFD0E4FF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                <Grid DataContext="{Binding TempStationParameter}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="桩号:" VerticalAlignment="Center" Margin="0,0,0,4" />
                  <Grid Row="0" Column="1" ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding StationKmInteger, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Text="km" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBlock Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox Grid.Column="3" Padding="4" Margin="0,0,4,4" HorizontalContentAlignment="Center" Text="{Binding StationMeter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="0,0,0,4" />
                  </Grid>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="道路宽度:" VerticalAlignment="Center" Margin="0,0,0,4" />
                  <TextBox Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,0,4,4" Text="{Binding RoadWidth, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#999999" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="横断面偏转角:" VerticalAlignment="Center" Margin="0,0,0,4" />
                  <TextBox Grid.Row="1" Grid.Column="4" Padding="4" Margin="0,0,4,4" Text="{Binding CrossSectionOffsetAngle, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="1" Grid.Column="5" Text="°" VerticalAlignment="Center" Foreground="#999999" />
                </Grid>
              </Border>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="添加桩号" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding AddStationParameterCommand}" />
                <Button Content="删除选中" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding RemoveSelectedStationParameterCommand}" />
                <Button Content="自动生成" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding AutoGenerateStationParametersCommand}" />
                <Button Content="清空列表" Style="{StaticResource SmallButton}" Margin="0,0,12,0" Command="{Binding ClearStationParametersCommand}" />
                <TextBlock Text="设置全部宽度:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox Width="60" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" Text="{Binding BulkRoadWidth, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="m" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" Foreground="#999999" />
                <Button Content="应用" Style="{StaticResource SmallButton}" Command="{Binding SetAllRoadWidthsCommand}" />
              </StackPanel>
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#FFF9F9F9" ItemsSource="{Binding StationParameters}" SelectedItem="{Binding SelectedStationParameter}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="桩号" Width="80" IsReadOnly="True" Binding="{Binding StationDisplay}" />
                  <DataGridTextColumn Header="道路宽度" Width="100" Binding="{Binding RoadWidth}" />
                  <DataGridTextColumn Header="横断面偏转角(°)" Width="120" Binding="{Binding CrossSectionOffsetAngle}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="6,0,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="平面曲线预览" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SectionHeaderBrush}" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Text="滚轮缩放 · 左键/中键拖动 · 右键拖动旋转 · 双击适应窗口" FontSize="11" Foreground="#99666666" Margin="0,0,0,8" />
              <Canvas Name="PlanPreviewCanvas" Background="#FFFAFAFA" ClipToBounds="True" MouseWheel="PlanPreviewCanvas_MouseWheel" MouseLeftButtonDown="PlanPreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PlanPreviewCanvas_MouseLeftButtonUp" MouseRightButtonDown="PlanPreviewCanvas_MouseRightButtonDown" MouseRightButtonUp="PlanPreviewCanvas_MouseRightButtonUp" PreviewMouseDown="PlanPreviewCanvas_PreviewMouseDown" PreviewMouseUp="PlanPreviewCanvas_PreviewMouseUp" MouseMove="PlanPreviewCanvas_MouseMove" SizeChanged="PlanPreviewCanvas_SizeChanged">
                <Canvas Name="PlanPreviewContent" Width="{Binding PlanPreviewWidth}" Height="{Binding PlanPreviewHeight}">
                  <UIElement.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PlanPreviewScale" ScaleX="1" ScaleY="1" />
                      <RotateTransform x:Name="PlanPreviewRotate" Angle="0" CenterX="0" CenterY="0" />
                      <TranslateTransform x:Name="PlanPreviewTranslate" X="0" Y="0" />
                    </TransformGroup>
                  </UIElement.RenderTransform>
                  <Polyline Stroke="#FF4CAF50" Opacity="0.7" Points="{Binding PlanLayoutPreviewData.LeftBoundaryPoints}" StrokeThickness="{Binding PlanLayoutPreviewData.BoundaryStrokeThickness}" Fill="{x:Null}" />
                  <Polyline Stroke="#FF4CAF50" Opacity="0.7" Points="{Binding PlanLayoutPreviewData.RightBoundaryPoints}" StrokeThickness="{Binding PlanLayoutPreviewData.BoundaryStrokeThickness}" Fill="{x:Null}" />
                  <ItemsControl ItemsSource="{Binding PlanLayoutPreviewData.CrossSectionLines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Canvas>
                          <Line Opacity="0.5" X1="{Binding LeftPoint.X}" Y1="{Binding LeftPoint.Y}" X2="{Binding RightPoint.X}" Y2="{Binding RightPoint.Y}" StrokeThickness="{Binding DataContext.PlanLayoutPreviewData.BoundaryStrokeThickness, ElementName=PlanPreviewCanvas}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Line}">
                                <Setter Property="Stroke" Value="#FFFF9800" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                    <Setter Property="Stroke" Value="#FFE91E63" />
                                    <Setter Property="StrokeThickness" Value="{Binding DataContext.PlanLayoutPreviewData.StrokeThickness, ElementName=PlanPreviewCanvas}" />
                                    <Setter Property="UIElement.Opacity" Value="0.9" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Line>
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Polyline Stroke="#FF0277BD" Points="{Binding PlanLayoutPreviewData.CenterlinePoints}" StrokeThickness="{Binding PlanLayoutPreviewData.StrokeThickness}" Fill="{x:Null}" />
                  <ItemsControl ItemsSource="{Binding PlanLayoutPreviewData.StationMarkers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                        <Setter Property="Panel.ZIndex" Value="-100" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Canvas Width="50" Height="50">
                          <Ellipse Canvas.Left="-1" Canvas.Top="-1" Stroke="#00CCCCCC" StrokeThickness="0" Fill="#00FFFFFF" RenderTransformOrigin="0.5,0.5" Width="{Binding DataContext.PlanLayoutPreviewData.MarkerSize, ElementName=PlanPreviewCanvas}" Height="{Binding DataContext.PlanLayoutPreviewData.MarkerSize, ElementName=PlanPreviewCanvas}">
                            <UIElement.RenderTransform>
                              <RotateTransform Angle="{Binding InverseRotationAngle, ElementName=PlanPreviewCanvas}" />
                            </UIElement.RenderTransform>
                          </Ellipse>
                          <TextBlock Foreground="#DD000000" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0.5,0" Text="{Binding DisplayText}" FontSize="{Binding DataContext.PlanLayoutPreviewData.FontSize, ElementName=PlanPreviewCanvas}">
                            <UIElement.RenderTransform>
                              <RotateTransform Angle="{Binding InverseRotationAngle, ElementName=PlanPreviewCanvas}" />
                            </UIElement.RenderTransform>
                          </TextBlock>
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Canvas>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="在整数桩号位置切分模型" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="{Binding SplitAtIntegerStations}" />
          <TextBlock Text="间隔:" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBox Width="50" Padding="4" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding IntegerStationInterval, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="米" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="保存到路线" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0" Command="{Binding SaveDataToRoadCommand}" />
          <Button Content="创建道路模型" Style="{StaticResource PrimaryButton}" Padding="20,8" Command="{Binding CreateSubgradeModelCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="4" Background="{StaticResource PrimaryLightBrush}" Padding="12,6" CornerRadius="4" Margin="0,8,0,0">
      <TextBlock FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}" Text="{Binding StatusMessage}" />
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar Width="200" Height="20" IsIndeterminate="True" Foreground="#FFFFFFFF" Margin="0,0,0,12" />
        <TextBlock Text="正在创建道路模型..." FontSize="14" Foreground="#FFFFFFFF" />
      </StackPanel>
    </Border>
  </Grid>
</Window>