<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RevitAi.UI.Views.Windows.DeviceLimitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:RevitAi.UI.Converters" WindowStartupLocation="CenterOwner" Title="设备数量已达上限" Width="500" Height="550" ResizeMode="NoResize" Background="#FFFFFF" WindowStyle="SingleBorderWindow" xmlns:windows="clr-namespace:RevitAi.UI.Views.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3" />
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE3F2FD" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFF44336" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Opacity" Value="0.8" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Opacity" Value="0.8" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CurrentDeviceButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#4CAF50" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DeviceCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="6" />
        <Setter Property="Border.Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PrimaryLightBrush}" Padding="20,16">
      <StackPanel>
        <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="设备数量已达上限" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="您的账户已绑定2台设备，达到最大数量。请解绑一台设备后继续。" FontSize="13" Foreground="#FF666666" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
      <StackPanel>
        <TextBlock Text="已绑定的设备：" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding UserDevices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource DeviceCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="14" FontWeight="Medium" Margin="0,0,0,4">
                      <Run Text="{Binding DeviceName}" /> <Run Text=" (" Foreground="#FF999999" FontSize="12" /> <Run Foreground="#FF999999" FontSize="12" Text="{Binding OsInfo}" /> <Run Text=")" Foreground="#FF999999" FontSize="12" /></TextBlock>
                    <TextBlock FontSize="11" Foreground="#FF999999" Margin="0,0,0,2">
                      <Run Text="设备ID: " /> <Run Text="{Binding DeviceId}" /></TextBlock>
                    <TextBlock FontSize="11" Foreground="#FF999999">
                      <Run Text="最后活动: " /> <Run Text="{Binding LastActiveString}" /></TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="当前" Style="{StaticResource CurrentDeviceButton}" Width="60" Height="28" Margin="12,0,0,0" Visibility="{Binding IsCurrentDevice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="解绑" Style="{StaticResource DangerButton}" Width="60" Height="28" Margin="12,0,0,0" Command="{Binding DataContext.UnbindDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DeviceId}" Visibility="{Binding IsCurrentDevice, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="暂无绑定设备" HorizontalAlignment="Center" FontSize="13" Foreground="#FF999999" Margin="0,20,0,0" Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#F5F5F5" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="取消" Style="{StaticResource PrimaryButton}" Background="#FFBDBDBD" Width="100" Height="32" Margin="0,0,12,0" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
    <Grid Background="#E0000000" RowSpan="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,0,12" />
        <TextBlock Text="处理中..." FontSize="14" Foreground="#FFFFFFFF" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>