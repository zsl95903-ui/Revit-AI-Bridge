<Project>
  <!-- Shared build settings for the RevitAi solution (rebuilt from AS.Tools 1.2.5.3) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0067;CS0169;CS0649;CS8981;CS0162;CS0219;CS0414;CS1998;CS8632;CS0108;CS0114;CS0168;CS0472;CS0728;CS1717;CS0660;CS0661;CS0282;CS0693;CS1591</NoWarn>
  </PropertyGroup>
