<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>RevitAi.CodexBridge</AssemblyName>
    <RootNamespace>RevitAi.CodexBridge</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RevitAiRebuildDir)\libs\R2027\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Abstractions">
      <HintPath>$(RevitAiRebuildDir)\build\payload\app\R2027\RevitAi.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Core">
      <HintPath>$(RevitAiRebuildDir)\build\payload\app\R2027\RevitAi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Revit">
      <HintPath>$(RevitAiRebuildDir)\build\payload\app\R2027\RevitAi.Revit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

