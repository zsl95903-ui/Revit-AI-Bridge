<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>RevitAi.Addin</AssemblyName>
    <RootNamespace>RevitAi.Addin</RootNamespace>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);MSB3277;CA2255</NoWarn>
    <ASToolsInstallDir Condition="'$(ASToolsInstallDir)' == ''">$(MSBuildThisFileDirectory)..\..\vendor\ASTools\R2024</ASToolsInstallDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(NuGetPackageRoot)nice3point.revit.api.revitapi\2024.3.60</RevitApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAi.Core">
      <HintPath>$(TEMP)\RevitAiV9.2VendorBuild\bin\RevitAi.Core\Release\net48\RevitAi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Abstractions">
      <HintPath>$(ASToolsInstallDir)\RevitAi.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Core">
      <HintPath>$(ASToolsInstallDir)\RevitAi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAi.Revit">
      <HintPath>$(ASToolsInstallDir)\RevitAi.Revit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ACadSharp">
      <HintPath>$(ASToolsInstallDir)\ACadSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ASToolsInstallDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(ASToolsInstallDir)\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(ASToolsInstallDir)\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>$(ASToolsInstallDir)\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(ASToolsInstallDir)\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="UI\*.html;UI\*.css;UI\*.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="UI\index.html">
      <LogicalName>RevitAi.Addin.UI.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="UI\styles.css">
      <LogicalName>RevitAi.Addin.UI.styles.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="UI\app.js">
      <LogicalName>RevitAi.Addin.UI.app.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
